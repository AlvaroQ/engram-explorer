/engram-explorer.exe~
/seed-demo
/seed-demo.exe
/bin/
*.exe~

# Demo database (generated by `make seed-demo` or `go run ./cmd/seed-demo`)
/demo/

# Local SQLite databases, WAL/SHM sidecars and backups (may hold personal data)
*.db
*.db-wal
*.db-shm
engram-backup-*.db

# CodeGraph local index
.codegraph/

# Ignore the real frontend build output but keep the placeholder index.html
# so `go build ./...` always compiles on a fresh clone without running
# `make build` first. The directory itself must be re-included because the
# generic `dist/` rule above would otherwise exclude it (git cannot re-include
# a file whose parent directory is excluded).
!internal/web/dist/
internal/web/dist/*
!internal/web/dist/index.html
*.test

# Gentle Design canvas: per-user review comments and capture cache
design/**/comments.json
design/**/.screenshots/
