package doctor

import (
	"fmt"
	"github.com/AlvaroQ/engram-explorer/internal/services"
)

// OrphansList renders only the orphans content fragment — no Layout shell.
// Used by HTMX for initial deferred load and post-action refresh.
templ OrphansList(data *services.OrphansResponse, projects []services.ProjectStats) {
	@orphansContent(data, projects)
}

// orphansContent is the shared inner content for both full-page and partial renders.
templ orphansContent(data *services.OrphansResponse, projects []services.ProjectStats) {
	<div id="orphans-list">
		<!-- Host for the observation-detail dialog. HTMX swaps the rendered
		     <dialog> into here; the dialog's close button clears it again. -->
		<div id="orphan-dialog-host"></div>
		if data.Totals.Observations == 0 && data.Totals.Sessions == 0 && data.Totals.Prompts == 0 {
			@EmptyState("No orphaned entities found. All observations, sessions, and prompts are assigned to a project.")
		} else {
			if data.Totals.Observations > 0 {
				<section class="orphans-section">
					<h2>Observations <span class="badge">{ fmt.Sprintf("%d", data.Totals.Observations) }</span></h2>
					<table>
						<thead>
							<tr>
								<th>ID</th>
								<th>Title</th>
								<th>Type</th>
								<th>Topic Key</th>
								<th>Session</th>
								<th>Updated At</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, obs := range data.Observations {
								<tr>
									<td>
										<button
											type="button"
											class="orphan-detail-link"
											hx-get={ fmt.Sprintf("/doctor/orphans/observations/%d/detail", obs.ID) }
											hx-target="#orphan-dialog-host"
											hx-swap="innerHTML"
											title="View details to help assign a project"
										>{ fmt.Sprintf("%d", obs.ID) }</button>
									</td>
									<td>
										if obs.Title != nil {
											{ *obs.Title }
										}
									</td>
									<td>{ obs.Type }</td>
									<td>
										if obs.TopicKey != nil {
											{ *obs.TopicKey }
										}
									</td>
									<td>
										if obs.SessionID != nil {
											{ *obs.SessionID }
										}
									</td>
									<td>
										if obs.UpdatedAt != nil {
											{ *obs.UpdatedAt }
										} else if obs.CreatedAt != nil {
											{ *obs.CreatedAt }
										}
									</td>
									@orphanRowActions("observations", fmt.Sprintf("%d", obs.ID), "observation", projects)
								</tr>
							}
						</tbody>
					</table>
				</section>
			}
			if data.Totals.Sessions > 0 {
				<section class="orphans-section">
					<h2>Sessions <span class="badge">{ fmt.Sprintf("%d", data.Totals.Sessions) }</span></h2>
					<table>
						<thead>
							<tr>
								<th>ID</th>
								<th>Directory</th>
								<th>Summary</th>
								<th>Started At</th>
								<th>Ended At</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, sess := range data.Sessions {
								<tr>
									<td>{ sess.ID }</td>
									<td>
										if sess.Directory != nil {
											{ *sess.Directory }
										}
									</td>
									<td>
										if sess.Summary != nil {
											{ truncate(*sess.Summary, 80) }
										}
									</td>
									<td>
										if sess.StartedAt != nil {
											{ *sess.StartedAt }
										}
									</td>
									<td>
										if sess.EndedAt != nil {
											{ *sess.EndedAt }
										}
									</td>
									@orphanRowActions("sessions", sess.ID, "session", projects)
								</tr>
							}
						</tbody>
					</table>
				</section>
			}
			if data.Totals.Prompts > 0 {
				<section class="orphans-section">
					<h2>Prompts <span class="badge">{ fmt.Sprintf("%d", data.Totals.Prompts) }</span></h2>
					<table>
						<thead>
							<tr>
								<th>ID</th>
								<th>Content (preview)</th>
								<th>Session ID</th>
								<th>Created At</th>
								<th>Actions</th>
							</tr>
						</thead>
						<tbody>
							for _, p := range data.Prompts {
								<tr>
									<td>{ fmt.Sprintf("%d", p.ID) }</td>
									<td>
										if p.Content != nil {
											{ truncate(*p.Content, 80) }
										}
									</td>
									<td>
										if p.SessionID != nil {
											{ *p.SessionID }
										}
									</td>
									<td>
										if p.CreatedAt != nil {
											{ *p.CreatedAt }
										}
									</td>
									@orphanRowActions("prompts", fmt.Sprintf("%d", p.ID), "prompt", projects)
								</tr>
							}
						</tbody>
					</table>
				</section>
			}
		}
	</div>
}

// orphanRowActions renders the assign-form + delete-button cell shared by all
// three orphan tables. entity is the URL segment ("observations"|"sessions"|
// "prompts"); id is the stringified entity id; label is the singular noun used
// in the delete confirmation prompt.
templ orphanRowActions(entity, id, label string, projects []services.ProjectStats) {
	<td class="actions">
		<form hx-post={ orphanActionURL(entity, id, "project") } hx-target="#orphans-list" hx-swap="outerHTML">
			@projectSelect(projects)
			<button type="submit" class="btn-action btn-icon" title="Assign to selected project" aria-label="Assign to selected project">
				@iconCheck()
			</button>
		</form>
		<button
			hx-delete={ orphanActionURL(entity, id, "") }
			hx-target="#orphans-list"
			hx-swap="outerHTML"
			hx-confirm={ "Delete this orphaned " + label + "? This action cannot be undone." }
			class="btn-danger btn-icon"
			title={ "Delete this orphaned " + label }
			aria-label={ "Delete this orphaned " + label }
		>
			@iconTrash()
		</button>
	</td>
}

// iconCheck renders the "assign" (confirm) glyph used on the icon-only Assign
// button in the orphan action cell.
templ iconCheck() {
	<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<polyline points="20 6 9 17 4 12"></polyline>
	</svg>
}

// iconTrash renders the trash glyph used on the icon-only Delete button.
templ iconTrash() {
	<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<polyline points="3 6 5 6 21 6"></polyline>
		<path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
		<path d="M10 11v6"></path>
		<path d="M14 11v6"></path>
		<path d="M9 6V4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"></path>
	</svg>
}

// projectSelect renders the shared "assign project" dropdown used by every
// orphan row. Empty project keys are skipped.
templ projectSelect(projects []services.ProjectStats) {
	<select name="project" required>
		<option value="">— assign project —</option>
		for _, p := range projects {
			if p.Project != "" {
				<option value={ p.Project }>{ p.Project }</option>
			}
		}
	</select>
}

// OrphansListWithError renders the orphans list preceded by an inline error
// message. Used when a write action fails but we still want to refresh the list.
templ OrphansListWithError(data *services.OrphansResponse, projects []services.ProjectStats, errMsg string) {
	@ErrorPartial(errMsg)
	@orphansContent(data, projects)
}

// OrphanObservationDetailDialog renders the observation-detail modal. It is
// swapped into #orphan-dialog-host. The dialog surfaces the metadata, the
// originating session's working directory (the key project hint) and the full
// observation content, and embeds the same assign-to-project dropdown and delete
// action used in the row so the user can act without leaving the dialog.
// Assigning/deleting refreshes #orphans-list (outerHTML), which removes the
// dialog along with the rest of the list markup. The close button clears the
// host directly. All strings stay in English to match the doctor view.
templ OrphanObservationDetailDialog(d *services.OrphanObservationDetail, projects []services.ProjectStats) {
	<dialog class="orphan-dialog" open aria-modal="true" aria-labelledby="orphan-dialog-title">
		<div class="orphan-dialog-backdrop" onclick="document.getElementById('orphan-dialog-host').innerHTML=''" aria-hidden="true"></div>
		<article class="orphan-dialog-card">
			<header class="orphan-dialog-header">
				<h3 id="orphan-dialog-title">
					if d.Title != nil && *d.Title != "" {
						{ *d.Title }
					} else {
						Observation #{ fmt.Sprintf("%d", d.ID) }
					}
				</h3>
				<button
					type="button"
					class="orphan-dialog-close"
					aria-label="Close"
					onclick="document.getElementById('orphan-dialog-host').innerHTML=''"
				>&times;</button>
			</header>
			<div class="orphan-dialog-body">
				if d.SessionDirectory != nil && *d.SessionDirectory != "" {
					<div class="orphan-dialog-dir">
						<span class="orphan-dialog-dir-label">Session working directory</span>
						<code class="orphan-dialog-dir-value">{ *d.SessionDirectory }</code>
					</div>
				} else {
					<div class="orphan-dialog-dir orphan-dialog-dir-empty">
						<span class="orphan-dialog-dir-label">Session working directory</span>
						<span class="orphan-dialog-dir-value">— unknown (no session directory recorded)</span>
					</div>
				}
				<dl class="orphan-dialog-meta">
					<div>
						<dt>ID</dt>
						<dd>{ fmt.Sprintf("%d", d.ID) }</dd>
					</div>
					<div>
						<dt>Type</dt>
						<dd>{ d.Type }</dd>
					</div>
					<div>
						<dt>Topic Key</dt>
						<dd>
							if d.TopicKey != nil && *d.TopicKey != "" {
								{ *d.TopicKey }
							} else {
								—
							}
						</dd>
					</div>
					<div>
						<dt>Tool</dt>
						<dd>
							if d.ToolName != nil && *d.ToolName != "" {
								{ *d.ToolName }
							} else {
								—
							}
						</dd>
					</div>
					<div>
						<dt>Session</dt>
						<dd>
							if d.SessionID != nil && *d.SessionID != "" {
								{ *d.SessionID }
							} else {
								—
							}
						</dd>
					</div>
					<div>
						<dt>Created</dt>
						<dd>
							if d.CreatedAt != nil {
								{ *d.CreatedAt }
							} else {
								—
							}
						</dd>
					</div>
					<div>
						<dt>Updated</dt>
						<dd>
							if d.UpdatedAt != nil {
								{ *d.UpdatedAt }
							} else {
								—
							}
						</dd>
					</div>
				</dl>
				<div class="orphan-dialog-content-block">
					<span class="orphan-dialog-content-label">Content</span>
					if d.Content != nil && *d.Content != "" {
						<pre class="orphan-dialog-content">{ *d.Content }</pre>
					} else {
						<p class="orphan-dialog-content-empty">No content recorded for this observation.</p>
					}
				</div>
			</div>
			<footer class="orphan-dialog-footer">
				<form
					hx-post={ orphanActionURL("observations", fmt.Sprintf("%d", d.ID), "project") }
					hx-target="#orphans-list"
					hx-swap="outerHTML"
					class="orphan-dialog-assign"
				>
					@projectSelect(projects)
					<button type="submit">Assign</button>
				</form>
				<button
					hx-delete={ orphanActionURL("observations", fmt.Sprintf("%d", d.ID), "") }
					hx-target="#orphans-list"
					hx-swap="outerHTML"
					hx-confirm="Delete this orphaned observation? This action cannot be undone."
					class="btn-danger"
				>Delete</button>
			</footer>
		</article>
	</dialog>
	<!-- Esc-to-close: native <dialog open> (attribute, not showModal) does not
	     handle Esc, so register a one-shot listener that clears the host. -->
	<script>
		(function () {
			function onKey(e) {
				if (e.key === "Escape") {
					var host = document.getElementById("orphan-dialog-host");
					if (host) host.innerHTML = "";
					document.removeEventListener("keydown", onKey);
				}
			}
			document.addEventListener("keydown", onKey);
		})();
	</script>
}
