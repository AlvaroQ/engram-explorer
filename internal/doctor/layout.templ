package doctor

import "github.com/AlvaroQ/engram-explorer/internal/ui"

// Layout wraps a doctor page in the shared app shell: the same sidebar, design
// tokens (/static/app.css + /static/styles.css) and dark theme as the rest of
// the dashboard, plus the doctor module's own component styles. This keeps the
// diagnostics pages visually consistent with the main UI instead of the old
// standalone Pico shell.
//
// activeNav must match a sidebar key so the correct item is highlighted:
// "syncHealth" for the sync pages, "orphans" for the orphans page.
// sidebarState is "expanded" or "collapsed" (server-side initial state, read from cookie).
templ Layout(title, activeNav, lang, theme, sidebarState string, content templ.Component) {
	<!DOCTYPE html>
	<html class={ theme } data-theme={ theme } lang={ lang }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — Engram</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="stylesheet" href="/static/styles.css"/>
			<link rel="stylesheet" href="/doctor/static/styles.css"/>
			<script src="/static/htmx.min.js" defer></script>
		</head>
		<body>
			<!-- Scrim for modal drawer on compact viewports -->
			<div class="sidebar-scrim" id="sidebar-scrim" aria-hidden="true"></div>
			<div class={ "app-shell", templ.KV("sidebar-collapsed", sidebarState == "collapsed") }>
				@ui.Sidebar(activeNav, lang, sidebarState)
				<main class="main-content">
					<div class="page-header">
						<h1>{ title }</h1>
					</div>
					@content
				</main>
			</div>
			<script src="/static/sidebar.js" defer></script>
		</body>
	</html>
}
