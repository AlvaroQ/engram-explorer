package doctor

import (
	"context"
	"fmt"
	"github.com/AlvaroQ/engram-explorer/internal/services"
	"github.com/AlvaroQ/engram-explorer/internal/ui"
)

// SyncShell renders only the sync shell content fragment — no Layout.
// Previously used when HX-Request: true on GET /doctor/sync; still kept for
// completeness but the maintenance page embeds syncShellContent directly.
templ SyncShell() {
	@syncShellContent()
}

// syncShellContent is the shared inner content for the sync page shell.
// It contains two deferred-load regions: projects table and issues banner.
// Polling pauses while the tab is hidden to avoid pointless background traffic:
// data-poll-visible-only is handled by /static/ui-actions.js (htmx runs with
// allowEval:false, so hx-trigger [filters] cannot be used).
templ syncShellContent() {
	<div id="sync-shell">
		<!--
			Sync issues are collapsed by default — the user opens the panel only
			if they want to inspect them. The <details> wrapper lives here (not in
			the polled partial) so its open/closed state survives the 15s refresh;
			the poll swaps only #sync-issues, and the count badge in the summary is
			refreshed out-of-band (hx-swap-oob) by SyncIssuesPartial.
		-->
		<details class="issues-details">
			<summary class="issues-summary">
				<span class="issues-summary-title">{ tr(ctx, "syncHealth.issuesPanel.title") }</span>
				<span id="sync-issues-count" class="badge">…</span>
			</summary>
			<div
				id="sync-issues"
				class="issues-body"
				hx-get="/doctor/sync/issues"
				hx-trigger="load, every 15s"
				data-poll-visible-only
				data-no-error-toast
				hx-target="#sync-issues"
				hx-swap="innerHTML"
			>
				<p class="loading">{ tr(ctx, "syncHealth.issuesPanel.loading") }</p>
			</div>
		</details>
		<div
			id="sync-projects"
			hx-get="/doctor/sync/projects"
			hx-trigger="load, every 15s"
			data-poll-visible-only
			data-no-error-toast
			hx-target="#sync-projects"
			hx-swap="innerHTML"
		>
			<p class="loading">{ tr(ctx, "syncHealth.projects.loading") }</p>
		</div>
	</div>
}

// SyncProjectsPartial renders the sync projects table fragment.
// Cloud is read-only: enrollment is shown as a status badge only; enrolling,
// unenrolling and syncing are done with the engram CLI directly.
templ SyncProjectsPartial(resp services.SyncProjectsResponse) {
	<div id="sync-projects-content">
		if resp.GlobalTarget != nil {
			<div class="global-target-card">
				<h3>{ tr(ctx, "syncHealth.globalTarget.heading") }</h3>
				<dl>
					<div class="gt-stat"><dt>{ tr(ctx, "syncHealth.globalTarget.targetKey") }</dt><dd>{ resp.GlobalTarget.TargetKey }</dd></div>
					if resp.GlobalTarget.Lifecycle != nil {
						<div class="gt-stat"><dt>{ tr(ctx, "syncHealth.globalTarget.lifecycle") }</dt><dd>{ *resp.GlobalTarget.Lifecycle }</dd></div>
					}
					if resp.GlobalTarget.LastEnqueuedSeq != nil {
						<div class="gt-stat"><dt>{ tr(ctx, "syncHealth.globalTarget.lastEnqueuedSeq") }</dt><dd>{ fmt.Sprintf("%d", *resp.GlobalTarget.LastEnqueuedSeq) }</dd></div>
					}
					if resp.GlobalTarget.LastAckedSeq != nil {
						<div class="gt-stat"><dt>{ tr(ctx, "syncHealth.globalTarget.lastAckedSeq") }</dt><dd>{ fmt.Sprintf("%d", *resp.GlobalTarget.LastAckedSeq) }</dd></div>
					}
					<div class="gt-stat"><dt>{ tr(ctx, "syncHealth.globalTarget.pendingMutations") }</dt><dd>{ fmt.Sprintf("%d", resp.GlobalTarget.PendingMutations) }</dd></div>
				</dl>
			</div>
		}
		if len(resp.Projects) == 0 {
			@ui.EmptyState(tr(ctx, "syncHealth.projects.empty"))
		} else {
			<table class="sync-projects-table">
				<thead>
					<tr>
						<th>{ tr(ctx, "syncHealth.projects.table.project") }</th>
						<th>{ tr(ctx, "syncHealth.projects.table.observations") }</th>
						<th>{ tr(ctx, "syncHealth.projects.table.lastActivity") }</th>
						<th>{ tr(ctx, "syncHealth.projects.table.enrolled") }</th>
						<th>{ tr(ctx, "syncHealth.projects.table.status") }</th>
						<th>{ tr(ctx, "syncHealth.projects.table.pending") }</th>
						<th>{ tr(ctx, "syncHealth.syncProject.lastAcked") }</th>
						<th>{ tr(ctx, "syncHealth.syncProject.lastEnqueued") }</th>
						<th>{ tr(ctx, "syncHealth.projects.table.actions") }</th>
					</tr>
				</thead>
				<tbody>
					for _, p := range resp.Projects {
						<tr>
							<td>
								<a href={ templ.URL(syncProjectURL(p.Project, "")) }>{ p.Project }</a>
							</td>
							<td>{ fmt.Sprintf("%d", p.ObsCount) }</td>
							<td>
								if p.LastActivity != nil {
									{ *p.LastActivity }
								}
							</td>
							<td>
								if p.Enrolled {
									<span class="badge badge-enrolled">{ tr(ctx, "syncHealth.projects.table.enrolledBadge") }</span>
								} else {
									<span class="badge badge-not-enrolled">{ tr(ctx, "syncHealth.projects.table.notEnrolled") }</span>
								}
							</td>
							<td>
								@syncStatusBadge(p.Status)
							</td>
							<td>{ fmt.Sprintf("%d", p.PendingMutations) }</td>
							<td>
								if p.LastAckedSeq != nil {
									{ fmt.Sprintf("%d", *p.LastAckedSeq) }
								}
							</td>
							<td>
								if p.LastEnqueuedSeq != nil {
									{ fmt.Sprintf("%d", *p.LastEnqueuedSeq) }
								}
							</td>
							<td class="actions">
								@syncProjectActions(p)
								<a href={ templ.URL(syncProjectURL(p.Project, "")) } class="btn-link">{ tr(ctx, "syncHealth.projects.table.detail") }</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</div>
}

// syncProjectActions renders the per-row maintenance actions. Cloud is
// read-only, so the only action is deleting a stray local project.
templ syncProjectActions(p services.SyncProjectRow) {
	// Delete is offered only for unenrolled, observation-free projects (e.g. a
	// stray "repo" with sessions/prompts but no captured knowledge). Enrolled or
	// non-empty projects never show the button — the server enforces the same
	// guard in services.DeleteProject.
	if !p.Enrolled && p.ObsCount == 0 {
		<button
			hx-post={ syncProjectURL(p.Project, "delete") }
			hx-target="#sync-projects"
			hx-swap="innerHTML"
			hx-confirm={ syncDeleteConfirm(ctx, p) }
			class="btn-danger"
		>{ tr(ctx, "syncHealth.projects.table.delete") }</button>
	}
}

// SyncIssuesPartial renders the body of the (collapsible) sync issues panel.
// The <details>/<summary> wrapper is owned by syncShellContent so its open
// state survives the 15s poll; here we (a) refresh the count badge in the
// summary out-of-band and (b) swap the issue list into #sync-issues.
templ SyncIssuesPartial(resp services.SyncIssuesResponse) {
	<span id="sync-issues-count" hx-swap-oob="true" class={ syncIssuesCountClass(resp.Issues) }>
		{ fmt.Sprintf("%d", len(resp.Issues)) }
	</span>
	if len(resp.Issues) == 0 {
		<p class="no-issues">{ tr(ctx, "syncHealth.issuesPanel.none") }</p>
	} else {
		<ul class="issues-list">
			for _, issue := range resp.Issues {
				<li class={ "issue-item issue-" + string(issue.Severity) }>
					<span class={ "severity-badge severity-" + string(issue.Severity) }>{ string(issue.Severity) }</span>
					<strong class="issue-code">{ issue.Code }</strong>
					<span class="issue-message">{ issue.Message }</span>
					if issue.Hint != nil {
						<span class="issue-hint">{ tr(ctx, "syncHealth.issuesPanel.hint", "hint", *issue.Hint) }</span>
					}
					if issue.Project != nil && *issue.Project != "" {
						<span class="issue-project">{ tr(ctx, "syncHealth.issuesPanel.project", "project", *issue.Project) }</span>
					}
				</li>
			}
		</ul>
		<p class="generated-at">{ tr(ctx, "syncHealth.issuesPanel.generatedAt", "time", resp.GeneratedAt) }</p>
	}
}

// SyncProjectDetailPartial renders the read-only project detail fragment.
// Includes status/sequence/counts cards, optional error card, pending
// mutations table, and optional upgrade-state card. The daemon-written
// last_error and reason_message texts are never rendered (they can carry
// hosts, paths or tokens):
// the error card shows a fixed localized message plus the reason code.
templ SyncProjectDetailPartial(detail *services.SyncProjectDetailResponse, lang string) {
	{{ slug := projectSlug(detail.Summary.Project) }}
	<div class={ "sync-detail-" + slug } id={ "sync-detail-" + slug }>
		<div class="detail-header">
			<h2>{ ui.T(lang, "syncHealth.syncProject.heading", "project", detail.Summary.Project) }</h2>
		</div>
		<div class="detail-cards">
			<div class="detail-card">
				<h4>{ ui.T(lang, "syncHealth.syncProject.status") }</h4>
				@syncStatusBadge(detail.Summary.Status)
				if detail.Summary.Lifecycle != nil {
					<p>{ ui.T(lang, "syncHealth.syncProject.lifecycleValue", "value", *detail.Summary.Lifecycle) }</p>
				}
				<p>
					{ ui.T(lang, "syncHealth.syncProject.enrolledLabel") }
					if detail.Summary.Enrolled {
						<span class="badge badge-enrolled">{ ui.T(lang, "common.yes") }</span>
					} else {
						<span class="badge badge-not-enrolled">{ ui.T(lang, "common.no") }</span>
					}
				</p>
				if detail.Summary.EnrolledAt != nil {
					<p>{ ui.T(lang, "syncHealth.syncProject.enrolledAtValue", "value", *detail.Summary.EnrolledAt) }</p>
				}
			</div>
			<div class="detail-card">
				<h4>{ ui.T(lang, "syncHealth.syncProject.sequence") }</h4>
				<dl>
					<dt>{ ui.T(lang, "syncHealth.syncProject.lastEnqueued") }</dt>
					<dd>
						if detail.Summary.LastEnqueuedSeq != nil {
							{ fmt.Sprintf("%d", *detail.Summary.LastEnqueuedSeq) }
						} else {
							—
						}
					</dd>
					<dt>{ ui.T(lang, "syncHealth.syncProject.lastAcked") }</dt>
					<dd>
						if detail.Summary.LastAckedSeq != nil {
							{ fmt.Sprintf("%d", *detail.Summary.LastAckedSeq) }
						} else {
							—
						}
					</dd>
					<dt>{ ui.T(lang, "syncHealth.syncProject.lastPulled") }</dt>
					<dd>
						if detail.Summary.LastPulledSeq != nil {
							{ fmt.Sprintf("%d", *detail.Summary.LastPulledSeq) }
						} else {
							—
						}
					</dd>
				</dl>
			</div>
			<div class="detail-card">
				<h4>{ ui.T(lang, "syncHealth.syncProject.counts") }</h4>
				<dl>
					<dt>{ ui.T(lang, "syncHealth.syncProject.observations") }</dt><dd>{ fmt.Sprintf("%d", detail.Summary.ObsCount) }</dd>
					<dt>{ ui.T(lang, "syncHealth.syncProject.sessions") }</dt><dd>{ fmt.Sprintf("%d", detail.Summary.SessionsCount) }</dd>
					<dt>{ ui.T(lang, "syncHealth.syncProject.prompts") }</dt><dd>{ fmt.Sprintf("%d", detail.Summary.PromptsCount) }</dd>
					<dt>{ ui.T(lang, "syncHealth.syncProject.pendingMutations") }</dt><dd>{ fmt.Sprintf("%d", detail.Summary.PendingMutations) }</dd>
				</dl>
			</div>
		</div>
		if detail.Summary.LastError != nil || detail.Summary.ReasonCode != nil {
			<div class="error-card">
				<h4>{ ui.T(lang, "syncHealth.syncProject.lastError") }</h4>
				if detail.Summary.LastError != nil {
					<p>{ ui.T(lang, "maintenance.cloud.lastErrorGeneric") }</p>
				}
				if detail.Summary.ReasonCode != nil {
					<p>{ ui.T(lang, "syncHealth.syncProject.reasonCode", "code", *detail.Summary.ReasonCode) }</p>
				}
				if detail.Summary.ConsecutiveFailures != nil {
					<p>{ ui.T(lang, "syncHealth.syncProject.consecutiveFailuresValue", "count", fmt.Sprintf("%d", *detail.Summary.ConsecutiveFailures)) }</p>
				}
			</div>
		}
		<div class="pending-mutations">
			<h3>{ ui.T(lang, "syncHealth.syncProject.pendingTitle") } <span class="badge">{ fmt.Sprintf("%d", len(detail.Pending)) }</span></h3>
			if len(detail.Pending) == 0 {
				@ui.EmptyState(ui.T(lang, "syncHealth.syncProject.pendingEmpty"))
			} else {
				<table class="mutations-table">
					<thead>
						<tr>
							<th>{ ui.T(lang, "syncHealth.syncProject.mutations.seq") }</th>
							<th>{ ui.T(lang, "syncHealth.syncProject.mutations.entity") }</th>
							<th>{ ui.T(lang, "syncHealth.syncProject.mutations.op") }</th>
							<th>{ ui.T(lang, "syncHealth.syncProject.mutations.entityKey") }</th>
							<th>{ ui.T(lang, "syncHealth.syncProject.mutations.occurredAt") }</th>
						</tr>
					</thead>
					<tbody>
						for _, m := range detail.Pending {
							<tr>
								<td>{ fmt.Sprintf("%d", m.Seq) }</td>
								<td>{ m.Entity }</td>
								<td>{ m.Op }</td>
								<td>
									if m.EntityKey != nil {
										{ *m.EntityKey }
									}
								</td>
								<td>
									if m.OccurredAt != nil {
										{ *m.OccurredAt }
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		</div>
		if detail.UpgradeState != nil {
			<div class="upgrade-state-card">
				<h4>{ ui.T(lang, "syncHealth.syncProject.cloudUpgrade") }</h4>
				<dl>
					if detail.UpgradeState.Stage != nil {
						<dt>{ ui.T(lang, "syncHealth.syncProject.stage") }</dt><dd>{ *detail.UpgradeState.Stage }</dd>
					}
					if detail.UpgradeState.RepairClass != nil {
						<dt>{ ui.T(lang, "syncHealth.syncProject.repairClass") }</dt><dd>{ *detail.UpgradeState.RepairClass }</dd>
					}
					if detail.UpgradeState.UpdatedAt != nil {
						<dt>{ ui.T(lang, "syncHealth.syncProject.updated") }</dt><dd>{ *detail.UpgradeState.UpdatedAt }</dd>
					}
				</dl>
				if detail.UpgradeState.Findings != nil {
					<details>
						<summary>{ ui.T(lang, "syncHealth.syncProject.findings") }</summary>
						<pre>{ prettyJSON(detail.UpgradeState.Findings) }</pre>
					</details>
				}
			</div>
		}
		<p><a href="/settings/maintenance#cloud">&larr; { ui.T(lang, "syncHealth.syncProject.backToMaintenance") }</a></p>
	</div>
}

// ---------------------------------------------------------------------------
// Badge helpers
// ---------------------------------------------------------------------------

// syncStatusBadge renders a status badge with appropriate CSS class.
templ syncStatusBadge(status services.SyncStatus) {
	switch status {
		case services.SyncStatusHealthy:
			<span class="badge badge-healthy">{ tr(ctx, "syncHealth.status.healthy") }</span>
		case services.SyncStatusDegraded:
			<span class="badge badge-degraded">{ tr(ctx, "syncHealth.status.degraded") }</span>
		case services.SyncStatusBroken:
			<span class="badge badge-broken">{ tr(ctx, "syncHealth.status.broken") }</span>
		case services.SyncStatusNotEnrolled:
			<span class="badge badge-not-enrolled">{ tr(ctx, "syncHealth.status.notEnrolled") }</span>
		case services.SyncStatusIdle:
			<span class="badge badge-idle">{ tr(ctx, "syncHealth.status.idle") }</span>
		default:
			<span class="badge">{ string(status) }</span>
	}
}

// syncHasHighIssues returns true if any issue has HIGH severity.
func syncHasHighIssues(issues []services.SyncIssue) bool {
	for _, i := range issues {
		if i.Severity == services.SyncIssueSeverityHigh {
			return true
		}
	}
	return false
}

// syncIssuesCountClass picks the summary count-badge tone so a collapsed panel
// still signals severity: red when any HIGH issue exists, amber when there are
// lower-severity issues, neutral when there are none.
func syncIssuesCountClass(issues []services.SyncIssue) string {
	switch {
	case syncHasHighIssues(issues):
		return "badge badge-broken"
	case len(issues) > 0:
		return "badge badge-degraded"
	default:
		return "badge"
	}
}

// syncDeleteConfirm builds the irreversible-delete confirmation prompt. It is
// lossless: the project's own prompts and now-empty sessions are removed, but
// sessions still holding observations that were reassigned to other projects
// are moved to follow that content, not deleted.
func syncDeleteConfirm(ctx context.Context, p services.SyncProjectRow) string {
	return tr(ctx, "syncHealth.projects.deleteConfirm", "project", p.Project)
}
