package ui

import (
	"encoding/json"
	"fmt"
	"regexp"
	"sort"
	"strings"

	"github.com/AlvaroQ/engram-explorer/internal/services"
)

// CCSDetailPage renders the full page for a single Claude Code session.
templ CCSDetailPage(detail *services.CCSessionDetail, lang, theme, sidebarState string) {
	@Layout(T(lang, "ccSessions.session")+" — "+detail.ID, "cc-sessions", lang, theme, sidebarState, ccsDetailContent(detail, lang))
}

// CCSDetailPartial renders only the content for HTMX partial swaps.
templ CCSDetailPartial(detail *services.CCSessionDetail, lang string) {
	@ccsDetailContent(detail, lang)
}

// ccsDetailContent is the shared body for detail (full-page + partial).
templ ccsDetailContent(detail *services.CCSessionDetail, lang string) {
	<div>
		<div class="page-header">
			<div class="page-header-back">
				<a href="/cc-sessions">← { T(lang, "common.back") }</a>
			</div>
			if title := ccsFirstUserPrompt(detail.Turns); title != "" {
				<h1 class="cc-detail-title">{ title }</h1>
			} else {
				<h1>{ T(lang, "common.untitled") }</h1>
			}
			<p class="muted mono cc-detail-id">{ detail.ID }</p>
		</div>
		<div class="card">
			<div class="card-body">
				<div class="cc-detail-cols">
					<div class="cc-detail-col">
						@ccsDetailField(T(lang, "ccSessions.fields.project"), detail.ProjectDisplay)
						@ccsDetailField(T(lang, "ccSessions.fields.cwd"), detail.CWD)
						@ccsDetailField(T(lang, "ccSessions.fields.branch"), detail.GitBranch)
						@ccsDetailField(T(lang, "ccSessions.fields.version"), detail.CCVersion)
					</div>
					<div class="cc-detail-col">
						@ccsDetailField(T(lang, "ccSessions.fields.started"), ccsFormatTime(detail.StartedAt))
						@ccsDetailField(T(lang, "ccSessions.fields.ended"), ccsFormatTime(detail.EndedAt))
						@ccsDetailField(T(lang, "ccSessions.fields.size"), ccsFormatSize(detail.FileSizeBytes))
						@ccsDetailField(T(lang, "ccSessions.fields.turns"), fmt.Sprintf("%d", len(detail.Turns)))
					</div>
					<div class="cc-detail-col">
						@ccsDetailField(T(lang, "ccSessions.fields.userTurns"), fmt.Sprintf("%d", countTurnsByRole(detail.Turns, "user")))
						@ccsDetailField(T(lang, "ccSessions.fields.assistantTurns"), fmt.Sprintf("%d", countTurnsByRole(detail.Turns, "assistant")))
						@ccsDetailField(T(lang, "ccSessions.fields.tokens"), ccsFormatTokens(detail.Usage.TotalTokens))
						@ccsDetailField(T(lang, "ccSessions.fields.cost"), ccsFormatCost(detail.Usage))
					</div>
				</div>
			</div>
		</div>
		<!-- Conversation timeline -->
		<div class="card cc-conv" style="margin-top: 1rem;">
			<div class="card-header card-header-flex">
				<div>
					<h2>{ T(lang, "ccSessions.conversation") }: <span class="cc-list-count">{ T(lang, "ccSessions.conversationDesc", "count", fmt.Sprintf("%d", len(detail.Turns))) }</span></h2>
				</div>
				if len(detail.Turns) > 0 {
					@ccsConvToolbar(lang)
				}
			</div>
			<div class="card-body">
				@ccsTurns(detail.Turns, lang)
			</div>
		</div>
		if len(detail.Turns) > 0 {
			<script src="/static/cc-conv-filter.js" defer></script>
		}
	</div>
}

// ccsConvToolbar renders the client-side conversation filter controls: a
// one-click "Compact" preset plus per-group toggles (thinking / tools /
// attachments). It lives in the conversation card-header (right side); the .cc-conv
// wrapper is the card itself, so the filtering JS (/static/cc-conv-filter.js) can
// reach both these controls and the turns in the card-body.
templ ccsConvToolbar(lang string) {
	<div class="cc-conv-toolbar">
		<button type="button" class="btn btn-secondary btn-sm" data-cc-compact aria-pressed="false">{ T(lang, "ccSessions.filter.compact") }</button>
		<span class="cc-conv-sep"></span>
		<label class="cc-conv-toggle">
			<input type="checkbox" data-cc-toggle="thinking" checked/>
			{ T(lang, "ccSessions.filter.thinking") }
		</label>
		<label class="cc-conv-toggle">
			<input type="checkbox" data-cc-toggle="tool" checked/>
			{ T(lang, "ccSessions.filter.tools") }
		</label>
		<label class="cc-conv-toggle">
			<input type="checkbox" data-cc-toggle="attachment" checked/>
			{ T(lang, "ccSessions.filter.attachments") }
		</label>
	</div>
}

// ccsDetailField renders one metadata cell as a stacked label/value pair (label
// above, value below). Long values stay on one line and overflow with an ellipsis
// while the full text remains available via the title tooltip — this keeps the
// 3-column grid rows the same height for a symmetric look.
templ ccsDetailField(label, value string) {
	<div class="cc-detail-field">
		<span class="cc-detail-label">{ label }</span>
		if value != "" {
			<span class="cc-detail-val" title={ value }>{ value }</span>
		} else {
			<span class="cc-detail-val muted">—</span>
		}
	</div>
}

// ccsTurns renders the conversation turns.
templ ccsTurns(turns []services.CCTurn, lang string) {
	if len(turns) == 0 {
		<p class="muted">{ T(lang, "ccSessions.noTurns") }</p>
	} else {
		<div class="timeline">
			for i, turn := range turns {
				<details class={ "timeline-event", "timeline-event--" + turn.Role }>
					<summary class="timeline-event-summary">
						<span class={ "badge", ccsTurnBadgeClass(turn.Role) }>{ turn.Role }</span>
						<span class="timeline-event-at muted mono">{ ccsShortTimestamp(turn.Timestamp) }</span>
						<span class="timeline-event-title">{ ccsTurnPreview(turn) }</span>
						<span class="timeline-event-index muted">{ fmt.Sprintf("#%d", i+1) }</span>
					</summary>
					<div class="timeline-event-body">
						if turn.Text != "" {
							@ccsRenderTextSegments(turn.Text)
						} else {
							@ccsTurnBlocks(turn.Blocks)
						}
					</div>
				</details>
			}
		</div>
	}
}

// ccsRenderTextSegments splits text into marker/plain segments and renders each
// appropriately: markers become compact chips, plain text is shown as a <pre>.
templ ccsRenderTextSegments(text string) {
	for _, seg := range ccsSplitMarkers(text) {
		if seg.IsMarker {
			@ccsAttachChip(seg.Tag, seg.Text)
		} else {
			<pre class="event-content" data-cc-block="text">{ seg.Text }</pre>
		}
	}
}

// ccsTurnBlocks renders the structured blocks of a turn.
templ ccsTurnBlocks(blocks []services.CCMessageBlock) {
	<div class="cc-blocks">
		for _, b := range blocks {
			switch b.Type {
				case "text":
					@ccsRenderTextSegments(b.Text)
				case "tool_use":
					<details class="cc-tool-block" data-cc-block="tool">
						<summary class="cc-tool-summary">
							<span class="badge badge-neutral">tool_use</span>
							<span class="mono text-xs">{ b.Name }</span>
							if b.ID != "" {
								<span class="muted mono text-xs">{ b.ID }</span>
							}
						</summary>
						<pre class="event-content cc-tool-input">{ ccsTruncateRaw(b.RawInput, 500) }</pre>
					</details>
				case "tool_result":
					<details class="cc-tool-block" data-cc-block="tool">
						<summary class="cc-tool-summary">
							<span class="badge badge-neutral">tool_result</span>
							if b.ToolUseID != "" {
								<span class="muted mono text-xs">{ b.ToolUseID }</span>
							}
						</summary>
						<pre class="event-content cc-tool-input">{ ccsTruncateRaw(b.Content, 500) }</pre>
					</details>
				case "thinking":
					<details class="cc-tool-block cc-thinking" data-cc-block="thinking">
						<summary class="cc-tool-summary">
							<span class="badge badge-neutral">thinking</span>
						</summary>
						<pre class="event-content cc-tool-input">{ b.Text }</pre>
					</details>
				default:
					<div class="muted mono text-xs" data-cc-block="other">{ b.Type }</div>
			}
		}
	</div>
}

// ccsAttachChip renders a marker/attachment block (e.g. <ide_opened_file>) as a
// compact paperclip chip. The full marker text is exposed via the title tooltip.
templ ccsAttachChip(tag, full string) {
	<span class="cc-attach" data-cc-block="attachment" title={ full }>
		@ccsPaperclip()
		<span class="cc-attach-label">{ tag }</span>
	</span>
}

// ccsPaperclip is the inline clip icon used by ccsAttachChip.
templ ccsPaperclip() {
	<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
	</svg>
}

// ---------------------------------------------------------------------------
// Helper functions for detail
// ---------------------------------------------------------------------------

// ccsMarkerTags is the canonical list of IDE/harness wrapper tags injected into
// Claude Code session transcripts. Both the detail view and the list view use
// this single source of truth for stripping and chip rendering.
var ccsMarkerTags = []string{
	"ide_opened_file",
	"ide_selection",
	"ide_diagnostics",
	"system-reminder",
	"local-command-caveat",
	"command-name",
	"command-message",
	"command-args",
	"local-command-stdout",
}

// ccsMarkerReList holds one compiled regexp per marker tag. RE2 (Go's regexp
// engine) has no backreferences, so we cannot write a single pattern like
// <(tag1|tag2)>.*?</\1>. Instead we compile one (?s)<tag\b[^>]*>.*?</tag>
// per tag, then merge and sort the match spans at runtime to handle overlaps.
var ccsMarkerReList = buildCCSMarkerReList()

func buildCCSMarkerReList() []*regexp.Regexp {
	res := make([]*regexp.Regexp, 0, len(ccsMarkerTags))
	for _, tag := range ccsMarkerTags {
		res = append(res, regexp.MustCompile(`(?s)<`+tag+`\b[^>]*>.*?</`+tag+`>`))
	}
	return res
}

// ccsSegment is one piece of a split transcript string.
type ccsSegment struct {
	IsMarker bool   // true → marker chip; false → plain text
	Tag      string // tag name when IsMarker
	Text     string // full marker text (IsMarker) or plain text (!IsMarker)
}

// markerSpan records the position and tag of one matched marker in a string.
type markerSpan struct {
	start, end int
	tag        string
}

// ccsSplitMarkers splits s into an ordered sequence of plain-text and marker
// segments. Marker spans are found by running each tag's regexp and collecting
// [start,end,tag] tuples; overlapping spans are dropped (first/leftmost wins).
// Plain-text segments that are whitespace-only are omitted.
func ccsSplitMarkers(s string) []ccsSegment {
	// Collect all marker spans across all tags.
	var spans []markerSpan
	for i, re := range ccsMarkerReList {
		for _, loc := range re.FindAllStringIndex(s, -1) {
			spans = append(spans, markerSpan{start: loc[0], end: loc[1], tag: ccsMarkerTags[i]})
		}
	}
	if len(spans) == 0 {
		// No markers: single plain-text segment.
		return []ccsSegment{{IsMarker: false, Text: s}}
	}

	// Sort by start position; on tie keep the longer span (greedy).
	sort.Slice(spans, func(i, j int) bool {
		if spans[i].start != spans[j].start {
			return spans[i].start < spans[j].start
		}
		return spans[i].end > spans[j].end
	})

	// Remove overlapping spans: keep a span only if its start is >= the end
	// of the last kept span.
	kept := spans[:0]
	cursor := 0
	for _, sp := range spans {
		if sp.start >= cursor {
			kept = append(kept, sp)
			cursor = sp.end
		}
	}
	spans = kept

	// Walk the string emitting segments.
	var out []ccsSegment
	pos := 0
	for _, sp := range spans {
		if pos < sp.start {
			plain := s[pos:sp.start]
			if strings.TrimSpace(plain) != "" {
				out = append(out, ccsSegment{IsMarker: false, Text: plain})
			}
		}
		out = append(out, ccsSegment{IsMarker: true, Tag: sp.tag, Text: s[sp.start:sp.end]})
		pos = sp.end
	}
	if pos < len(s) {
		plain := s[pos:]
		if strings.TrimSpace(plain) != "" {
			out = append(out, ccsSegment{IsMarker: false, Text: plain})
		}
	}
	return out
}

// ccsAttachment reports whether text is a single wrapped marker block and, if so,
// returns the tag name for the chip label. Used for the all-or-nothing fast path
// (e.g. list view first-prompt detection).
func ccsAttachment(text string) (string, bool) {
	t := strings.TrimSpace(text)
	for _, tag := range ccsMarkerTags {
		if strings.HasPrefix(t, "<"+tag+">") || strings.HasPrefix(t, "<"+tag+" ") {
			return tag, true
		}
	}
	return "", false
}

// ccsTurnPlainText returns the human-readable text of a turn: the direct Text,
// or the first non-empty text block.
func ccsTurnPlainText(t services.CCTurn) string {
	if strings.TrimSpace(t.Text) != "" {
		return t.Text
	}
	for _, b := range t.Blocks {
		if b.Type == "text" && strings.TrimSpace(b.Text) != "" {
			return b.Text
		}
	}
	return ""
}

// ccsFirstUserPrompt returns the first real user message — skipping marker-only
// turns and stripping IDE attachment segments — for use as a descriptive page
// title (the raw session ID is shown as a subtitle instead).
func ccsFirstUserPrompt(turns []services.CCTurn) string {
	for _, t := range turns {
		if t.Role != "user" {
			continue
		}
		text := ccsTurnPlainText(t)
		if text == "" {
			continue
		}
		if clean := ccsPlainFromSegments(ccsSplitMarkers(text)); clean != "" {
			return clean
		}
	}
	return ""
}

// ccsTurnBadgeClass returns the badge class based on role.
func ccsTurnBadgeClass(role string) string {
	if role == "user" {
		return "badge badge-accent"
	}
	return "badge badge-neutral"
}

// ccsTurnPreview returns a short preview of a turn for the summary line.
// Marker segments are stripped; only plain-text segments are shown. If the
// entire text consists of markers, the attachment label is returned instead.
func ccsTurnPreview(turn services.CCTurn) string {
	if turn.Text != "" {
		plain := ccsPlainFromSegments(ccsSplitMarkers(turn.Text))
		if plain == "" {
			return "📎 attachment"
		}
		return ccsPromptPreview(plain)
	}
	// Summarise blocks.
	var parts []string
	for _, b := range turn.Blocks {
		switch b.Type {
		case "text":
			plain := ccsPlainFromSegments(ccsSplitMarkers(b.Text))
			if plain != "" {
				parts = append(parts, ccsPromptPreview(plain))
			} else if b.Text != "" {
				parts = append(parts, "📎 attachment")
			}
		case "tool_use":
			parts = append(parts, "⚙ "+b.Name)
		case "tool_result":
			parts = append(parts, "→ result")
		case "thinking":
			parts = append(parts, "💭 thinking")
		}
	}
	if len(parts) == 0 {
		return "(empty)"
	}
	s := strings.Join(parts, " · ")
	runes := []rune(s)
	if len(runes) > 100 {
		return string(runes[:100]) + "…"
	}
	return s
}

// ccsPlainFromSegments joins plain-text segments into a single normalised string.
func ccsPlainFromSegments(segs []ccsSegment) string {
	var parts []string
	for _, seg := range segs {
		if !seg.IsMarker {
			parts = append(parts, seg.Text)
		}
	}
	return strings.Join(strings.Fields(strings.Join(parts, " ")), " ")
}

// ccsShortTimestamp returns just the time portion of an ISO 8601 timestamp.
func ccsShortTimestamp(ts string) string {
	if ts == "" {
		return "—"
	}
	// "2026-06-08T18:33:44.910Z" → "18:33:44"
	t := ts
	if idx := strings.Index(t, "T"); idx >= 0 {
		t = t[idx+1:]
	}
	if idx := strings.Index(t, "."); idx >= 0 {
		t = t[:idx]
	}
	if idx := strings.Index(t, "Z"); idx >= 0 {
		t = t[:idx]
	}
	return t
}

// ccsTruncateRaw returns a truncated JSON string for large raw JSON inputs.
func ccsTruncateRaw(raw json.RawMessage, maxRunes int) string {
	if len(raw) == 0 || string(raw) == "null" {
		return "—"
	}
	runes := []rune(string(raw))
	if len(runes) <= maxRunes {
		return string(runes)
	}
	return string(runes[:maxRunes]) + "… [truncated]"
}

// countTurnsByRole counts turns with a specific role.
func countTurnsByRole(turns []services.CCTurn, role string) int {
	n := 0
	for _, t := range turns {
		if t.Role == role {
			n++
		}
	}
	return n
}
