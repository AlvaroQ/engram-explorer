package ui

// Transcript components shared by the agent-session pages (moved from the
// former Claude Code session detail template).

// ccsRenderTextSegments splits text into marker/plain segments with the marker
// set of agent and renders each appropriately: markers become compact chips,
// plain text is shown as a <pre>.
templ ccsRenderTextSegments(agent, text string) {
	for _, seg := range asSplitMarkers(agent, text) {
		if seg.IsMarker {
			@ccsAttachChip(seg.Tag, seg.Text)
		} else {
			<pre class="event-content" data-cc-block="text">{ seg.Text }</pre>
		}
	}
}

// ccsAttachChip renders a marker/attachment block (e.g. <ide_opened_file>) as a
// compact paperclip chip whose label is the readable text *inside* the marker
// (truncated), so the transcript shows the actual context (e.g. which file was
// opened) rather than the raw "ide_opened_file" tag name. The full marker text
// stays available via the title tooltip.
templ ccsAttachChip(tag, full string) {
	<span class="cc-attach" data-cc-block="attachment" title={ full }>
		@ccsPaperclip()
		<span class="cc-attach-label">{ ccsMarkerLabel(tag, full) }</span>
	</span>
}

// ccsPaperclip is the inline clip icon used by ccsAttachChip.
templ ccsPaperclip() {
	<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path>
	</svg>
}

// ccsDetailField renders one metadata cell as a stacked label/value pair (label
// above, value below). Long values stay on one line and overflow with an ellipsis
// while the full text remains available via the title tooltip — this keeps the
// 3-column grid rows the same height for a symmetric look.
templ ccsDetailField(label, value string) {
	<div class="cc-detail-field">
		<span class="cc-detail-label">{ label }</span>
		if value != "" {
			<span class="cc-detail-val" title={ value }>{ value }</span>
		} else {
			<span class="cc-detail-val muted">—</span>
		}
	</div>
}

// ccsConvToolbar renders the client-side conversation filter controls: a
// one-click "Compact" preset plus per-group toggles (thinking / tools /
// attachments). It lives in the conversation card-header (right side); the .cc-conv
// wrapper is the card itself, so the filtering JS (/static/cc-conv-filter.js) can
// reach both these controls and the turns in the card-body.
templ ccsConvToolbar(lang string) {
	<div class="cc-conv-toolbar">
		<button type="button" class="btn btn-secondary btn-sm" data-cc-compact aria-pressed="false">{ T(lang, "agentSessions.filter.compact") }</button>
		<span class="cc-conv-sep"></span>
		<label class="cc-conv-toggle">
			<input type="checkbox" data-cc-toggle="thinking" checked/>
			{ T(lang, "agentSessions.filter.reasoning") }
		</label>
		<label class="cc-conv-toggle">
			<input type="checkbox" data-cc-toggle="tool" checked/>
			{ T(lang, "agentSessions.filter.tools") }
		</label>
		<label class="cc-conv-toggle">
			<input type="checkbox" data-cc-toggle="attachment" checked/>
			{ T(lang, "agentSessions.filter.attachments") }
		</label>
	</div>
}
