package ui

import (
	"fmt"

	"github.com/AlvaroQ/engram-explorer/internal/services"
)

// overviewView is the data of the overview page.
type overviewView struct {
	Data   services.OverviewResponse
	Issues services.SyncIssuesResponse
	Lang   string
	// AgentsLive reports a live agent-session source: the agent KPI cards
	// then load lazily from /partials/overview-agents; otherwise they show
	// the empty state.
	AgentsLive bool
}

// OverviewPage renders the full overview page shell.
templ OverviewPage(v overviewView, theme, sidebarState string) {
	@Layout(T(v.Lang, "sidebar.overview"), "overview", v.Lang, theme, sidebarState, overviewContent(v))
}

// OverviewPartial renders only the overview content (no HTML shell).
// Used when HTMX requests a partial update.
templ OverviewPartial(v overviewView) {
	@overviewContent(v)
}

// overviewContent is the shared overview body (02-brain-first artboard):
// the sync alert, the hero (title, CTA, search), the KPI cards and, below
// the fold, the charts and the recent memories.
templ overviewContent(v overviewView) {
	<div class="overview" id="overview">
		<!-- Sync issues alert bar — rendered only when issues are present.
		     Links straight to /settings/maintenance (no #cloud fragment) so the
		     page opens at the top instead of jumping down to the cloud section. -->
		if len(v.Issues.Issues) > 0 {
			<div class="ov-alert" id="overview-sync-alert">
				<span class="text-warn" aria-hidden="true">⚠</span>
				<span class="flex-1 text-fg">{ T(v.Lang, "overview.alert.syncIssues", "count", fmt.Sprintf("%d", len(v.Issues.Issues))) }</span>
				<a href="/settings/maintenance" class="font-medium text-fg underline">{ T(v.Lang, "overview.alert.review") }</a>
			</div>
		}
		@overviewHero(v.Lang)
		@overviewKPIs(v)
		<!-- Collapsing hero runtime (/islands/overview-collapse.js): scroll →
		     CSS custom properties on .overview; see styles.css. -->
		<div hidden data-island="overview-collapse" data-props="{}"></div>
		<div class="ov-below">
			<!-- Charts row: activity (span-2) + type breakdown -->
			<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
				<!-- Activity by project — React island (fetches /api/activity on its own) -->
				<div class="card flex flex-col lg:col-span-2">
					<div class="card-header">
						<div>
							<h2>{ T(v.Lang, "overview.activity.title") }</h2>
							<p>{ T(v.Lang, "overview.activity.description") }</p>
						</div>
					</div>
					<div class="card-body chart-h-300">
						@Island("activity-by-project-chart", struct{}{})
					</div>
				</div>
				<!-- Type breakdown — React island (data passed via props) -->
				<div class="card flex flex-col">
					<div class="card-header">
						<div>
							<h2>{ T(v.Lang, "overview.byType.title") }</h2>
							<p>{ T(v.Lang, "overview.byType.description") }</p>
						</div>
					</div>
					<div class="card-body chart-h-280">
						@Island("type-breakdown", TypeBreakdownIslandProps{ByType: toTypeBreakdownEntries(v.Data.ByType)})
					</div>
				</div>
			</div>
			<!-- Recent memories — server-rendered, newest by creation (the same
			     created_at day the activity chart buckets by) -->
			<div class="card">
				<div class="card-header">
					<div>
						<h2>{ T(v.Lang, "overview.recent.title") }</h2>
						<p>{ T(v.Lang, "overview.recent.description") }</p>
					</div>
					<a href="/observations" class="btn btn-sm">{ T(v.Lang, "overview.recent.viewAll") }</a>
				</div>
				<div class="card-body p-0">
					@overviewRecentTable(v.Data.RecentObservations, v.Lang)
				</div>
			</div>
		</div>
	</div>
}

// overviewHero is the hero band: page title, CTA to the Knowledge Graph and
// the memory search (a plain GET /observations?q= form).
templ overviewHero(lang string) {
	<section class="ov-hero" id="ov-hero" aria-labelledby="ov-title">
		<div class="ov-hero-back">
			<!-- The graph island labels itself (role="img"); the solid bar
			     layer is decoration. -->
			<div class="ov-hero-canvas">
				@Island("brain-preview-hero", struct{}{})
			</div>
			<div class="ov-hero-solid" aria-hidden="true"></div>
		</div>
		<div class="ov-hero-ui" id="ov-hero-ui">
			<header class="ov-hero-head">
				<p class="ov-eyebrow" data-collapse-fade>Engram</p>
				<h1 id="ov-title">{ T(lang, "sidebar.overview") }</h1>
				<p class="ov-sub" data-collapse-fade>{ T(lang, "overview.hero.subtitle") }</p>
				<p class="ov-cta" data-collapse-fade>
					<a class="btn btn-tonal" href="/brain">{ T(lang, "overview.hero.openGraph") }</a>
				</p>
			</header>
			<form class="ov-search glass" id="ov-search" role="search" action="/observations" method="get">
				<label class="sr-only" for="ov-q">{ T(lang, "overview.hero.searchLabel") }</label>
				<input id="ov-q" type="search" name="q" autocomplete="off" placeholder={ T(lang, "overview.hero.searchLabel") }/>
			</form>
		</div>
	</section>
}

// overviewKPIs renders the four KPI cards. Each card has two versions: the
// full card and the strip link shown once the cards pin under the collapsed
// hero (S4: the strip keeps the card's target reachable). The strip starts
// inert + aria-hidden; the collapse script swaps which version is exposed.
templ overviewKPIs(v overviewView) {
	<section class="ov-kpis" id="ov-kpis" aria-labelledby="ov-kpi-h">
		<h2 id="ov-kpi-h" class="sr-only">{ T(v.Lang, "overview.kpi.keyFigures") }</h2>
		@overviewKPI("memories", T(v.Lang, "overview.kpi.observations"), "/observations", fmt.Sprintf("%d", v.Data.KPIs.Observations)) {
			<p class="kpi-value">{ fmt.Sprintf("%d", v.Data.KPIs.Observations) }</p>
			<p class="kpi-cap">
				{ T(v.Lang, "overview.kpi.last7d", "count", fmt.Sprintf("%d", v.Data.KPIs.ObservationsLast7d)) } · <a href="/observations">{ T(v.Lang, "overview.kpi.browse") }</a>
			</p>
		}
		@overviewKPI("projects", T(v.Lang, "overview.kpi.projects"), overviewProjectHref(v.Data.KPIs.MostActiveProject), fmt.Sprintf("%d", v.Data.KPIs.Projects)) {
			<p class="kpi-value">{ fmt.Sprintf("%d", v.Data.KPIs.Projects) }</p>
			<p class="kpi-cap">
				if v.Data.KPIs.MostActiveProject != "" {
					{ T(v.Lang, "overview.kpi.mostActive") } <span class="mono">{ v.Data.KPIs.MostActiveProject }</span> ·
				}
				<a href={ templ.SafeURL(overviewProjectHref(v.Data.KPIs.MostActiveProject)) }>{ T(v.Lang, "overview.kpi.drillIn") }</a>
			</p>
		}
		@overviewAgentKPI(v, "conversations", T(v.Lang, "overview.kpi.sessions"), "/agent-sessions/list")
		@overviewAgentKPI(v, "spend", T(v.Lang, "overview.kpi.spend"), "/agent-sessions")
		if v.AgentsLive {
			<div hidden hx-get="/partials/overview-agents" hx-trigger="load" hx-swap="none"></div>
		}
	</section>
}

// overviewKPI is one KPI: the full card (children after the label) and the
// strip link. The trailing comment marks the card end for tests.
templ overviewKPI(id, label, href, miniValue string) {
	<div class="ov-kpi glass" id={ "kpi-" + id }>
		<div class="ov-kpi-full">
			<p class="kpi-label">{ label }</p>
			{ children... }
		</div>
		<a class="ov-kpi-mini" href={ templ.SafeURL(href) } aria-hidden="true" inert>
			<span class="kpi-label">{ label }</span>
			<span class="ov-kpi-mini-v" id={ "kpi-" + id + "-mini-v" }>{ miniValue }</span>
		</a>
	</div>
	<!-- /kpi -->
}

// overviewAgentKPI is an agent card: the empty state without a live agent,
// otherwise a loading body filled out of band by /partials/overview-agents.
templ overviewAgentKPI(v overviewView, id, label, href string) {
	if v.AgentsLive {
		@overviewKPI(id, label, href, "…") {
			<div id={ "kpi-" + id + "-body" } aria-busy="true">
				<p class="kpi-value">…</p>
				<p class="kpi-cap">{ T(v.Lang, "common.loading") }</p>
			</div>
		}
	} else {
		@overviewKPI(id, label, "/settings#settings-modules", "—") {
			<p class="kpi-cap">{ T(v.Lang, "overview.kpi.agentsEmpty") }</p>
			<p class="kpi-cap"><a href="/settings#settings-modules">{ T(v.Lang, "overview.kpi.agentsSetup") }</a></p>
		}
	}
}

// overviewRecentTable renders the "recent observations" table (server-side).
templ overviewRecentTable(items []services.OverviewRecentObs, lang string) {
	if len(items) == 0 {
		<p class="px-5 py-4 text-sm text-fg-muted">{ T(lang, "overview.recent.empty") }</p>
	} else {
		<div class="overflow-x-auto">
			<table class="w-full border-collapse text-sm">
				<thead class="bg-surface-2 text-xs uppercase tracking-wide text-fg-muted">
					<tr>
						<th class="px-5 py-3 text-left font-medium">{ T(lang, "overview.recent.col.created") }</th>
						<th class="px-3 py-3 text-left font-medium">{ T(lang, "overview.recent.col.type") }</th>
						<th class="px-3 py-3 text-left font-medium">{ T(lang, "overview.recent.col.title") }</th>
						<th class="px-5 py-3 text-left font-medium">{ T(lang, "overview.recent.col.project") }</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-border">
					for _, o := range items {
						<tr class="align-top hover:bg-surface-2/50">
							<td class="whitespace-nowrap px-5 py-3 text-xs text-fg-muted">
								@dateClockCell(derefStr(o.CreatedAt, ""))
							</td>
							<td class="px-3 py-3">
								<span class="badge badge-neutral">{ o.Type }</span>
							</td>
							<td class="px-3 py-3 text-fg">
								<p class="truncate leading-snug">{ derefStr(o.Title, T(lang, "common.untitled")) }</p>
							</td>
							<td class="px-5 py-3 text-fg">
								if o.Project != nil && *o.Project != "" {
									<span class="badge badge-neutral">{ *o.Project }</span>
								} else {
									<span class="italic text-fg-muted">—</span>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
}

// overviewIssuesTable renders the sync issues grouped by project.
// Groups are collapsible via HTML <details>/<summary> — zero JavaScript needed.
templ overviewIssuesTable(resp services.SyncIssuesResponse, lang string) {
	if len(resp.Issues) == 0 {
		<p class="px-5 py-4 text-sm text-ok">{ T(lang, "overview.issues.none") }</p>
	} else {
		<div class="divide-y divide-border">
			for _, group := range groupSyncIssues(resp.Issues) {
				<details class="group">
					<summary class="flex cursor-pointer list-none items-center gap-3 px-5 py-3 hover:bg-surface-2/50">
						<span class="text-fg-muted" aria-hidden="true">▶</span>
						<span class="whitespace-nowrap text-xs text-fg-muted">{ resp.GeneratedAt }</span>
						if group.IsGlobal {
							<span class="italic text-fg-muted">{ T(lang, "overview.issues.global") }</span>
						} else {
							<span class="font-medium text-fg">{ group.Key }</span>
						}
						<span class={ "ml-auto", overviewSeverityBadgeClass(string(group.MaxSeverity)) }>
							{ string(group.MaxSeverity) }
						</span>
						<span class="font-mono text-xs text-fg-muted">
							{ overviewIssueCountLabel(len(group.Issues), lang) }
						</span>
					</summary>
					<div class="bg-surface-2/30 px-5 py-3">
						<ul class="flex flex-col divide-y divide-border/60">
							for _, issue := range group.Issues {
								<li class="flex flex-col gap-1 py-2 first:pt-0 last:pb-0 sm:flex-row sm:items-start sm:gap-3">
									<div class="flex shrink-0 items-center gap-2">
										<span class={ overviewSeverityBadgeClass(string(issue.Severity)) }>{ string(issue.Severity) }</span>
										<code class="rounded bg-surface px-1.5 py-0.5 font-mono text-xs text-fg">{ issue.Code }</code>
									</div>
									<div class="min-w-0 flex-1 text-fg">
										<p class="leading-snug">{ issue.Message }</p>
										if issue.Hint != nil && *issue.Hint != "" {
											<p class="mt-1 text-xs text-fg-muted leading-snug">{ *issue.Hint }</p>
										}
									</div>
								</li>
							}
						</ul>
					</div>
				</details>
			}
		</div>
	}
}
