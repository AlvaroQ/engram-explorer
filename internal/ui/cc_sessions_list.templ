package ui

import (
	"fmt"
	"net/url"
	"strings"

	"github.com/AlvaroQ/engram-explorer/internal/services"
)

// CCSListPage renders the full page shell for the Claude Code sessions list.
templ CCSListPage(result services.CCSessionListResult, params services.CCSessionListParams, lang, theme string) {
	@Layout(T(lang, "ccSessions.title"), "cc-sessions", lang, theme, ccsListContent(result, params, lang))
}

// CCSListPartial renders only the content for HTMX partial swaps.
templ CCSListPartial(result services.CCSessionListResult, params services.CCSessionListParams, lang string) {
	@ccsListContent(result, params, lang)
}

// ccsListContent is the shared body for both full-page and partial renders.
templ ccsListContent(result services.CCSessionListResult, params services.CCSessionListParams, lang string) {
	<div>
		<div class="page-header">
			<h1>{ T(lang, "ccSessions.title") }</h1>
			<p>{ T(lang, "ccSessions.description") }</p>
		</div>
		<div class="card filter-bar">
			<div class="card-body">
				<form
					method="get"
					action="/cc-sessions/list"
					hx-get="/cc-sessions/list"
					hx-target="#cc-sessions-table-container"
					hx-trigger="change"
					hx-push-url="false"
					class="filter-row"
				>
					<div class="filter-group">
						<label class="filter-label">{ T(lang, "ccSessions.filterProject") }</label>
						<select name="project" class="input input-sm">
							<option value="" selected?={ params.Project == "" }>{ T(lang, "common.all") }</option>
							for _, proj := range result.Projects {
								<option value={ proj } selected?={ params.Project == proj }>{ proj }</option>
							}
						</select>
					</div>
				</form>
			</div>
		</div>
		<div class="card">
			<div class="card-header">
				<h2>{ T(lang, "ccSessions.listTitle") }</h2>
				<p>{ T(lang, "ccSessions.listLoaded", "count", fmt.Sprintf("%d", len(result.Items))) }</p>
			</div>
			<div class="card-body p-0" id="cc-sessions-table-container">
				@CCSListBodyPartial(result, params, lang)
			</div>
		</div>
	</div>
}

// CCSListBodyPartial renders the full table + load-more button.
// This is the HTMX swap target for filter changes.
templ CCSListBodyPartial(result services.CCSessionListResult, params services.CCSessionListParams, lang string) {
	if len(result.Items) == 0 {
		@EmptyState(T(lang, "ccSessions.noMatch"))
	} else {
		<div class="overflow-x-auto">
			<table class="w-full text-sm">
				<thead class="table-head">
					<tr>
						<th class="px-4 py-2 text-left">{ T(lang, "ccSessions.col.ended") }</th>
						<th class="px-4 py-2 text-left">{ T(lang, "ccSessions.col.prompt") }</th>
						<th class="px-4 py-2 text-right">{ T(lang, "ccSessions.col.tokens") }</th>
						<th class="px-4 py-2 text-right">{ T(lang, "ccSessions.col.cost") }</th>
						<th class="px-4 py-2 text-right">{ T(lang, "ccSessions.col.size") }</th>
						<th class="px-4 py-2 text-left">{ T(lang, "ccSessions.col.project") }</th>
						<th class="px-4 py-2 text-left">{ T(lang, "ccSessions.col.branch") }</th>
					</tr>
				</thead>
				<tbody id="cc-sessions-tbody" class="divide-y">
					@CCSRowsPartial(result, params, lang)
				</tbody>
			</table>
		</div>
	}
}

// CCSRowsPartial renders only the <tr> rows, used by load-more (hx-swap="beforeend").
templ CCSRowsPartial(result services.CCSessionListResult, params services.CCSessionListParams, lang string) {
	for _, s := range result.Items {
		@ccsSessionRow(s, lang)
	}
	if result.NextCursor != nil {
		@ccsLoadMoreRow(*result.NextCursor, params, lang)
	}
}

// ccsSessionRow renders a single session row.
// Column order puts Last modified first (the marker used to locate a session —
// the list is sorted by it, newest first; date and time stack on two lines to
// keep the column narrow), then the full First prompt (the most important
// column), then project, tokens, cost, etc.
templ ccsSessionRow(s services.CCSessionListItem, lang string) {
	<tr class="hover:bg-surface-2 align-top">
		<td class="px-4 py-2 mono text-xs text-fg-muted whitespace-nowrap">
			<div>{ ccsFormatDate(s.EndedAt) }</div>
			<div class="muted">{ ccsFormatClock(s.EndedAt) }</div>
		</td>
		<td class="px-4 py-2">
			<a
				href={ templ.SafeURL("/cc-sessions/" + url.PathEscape(s.ProjectFolder) + "/" + s.ID) }
				class="text-sm text-fg hover:text-accent"
			>
				if s.FirstPrompt != "" {
					{ ccsPromptOneLine(s.FirstPrompt) }
				} else {
					<span class="muted">{ T(lang, "common.untitled") }</span>
				}
			</a>
		</td>
		<td class="px-4 py-2 mono text-xs text-fg-muted text-right whitespace-nowrap" title={ ccsTokensBreakdown(s.Usage, lang) }>{ ccsFormatTokens(s.Usage.TotalTokens) }</td>
		<td class="px-4 py-2 mono text-xs text-right whitespace-nowrap">{ ccsFormatCost(s.Usage) }</td>
		<td class="px-4 py-2 mono text-xs text-fg-muted text-right whitespace-nowrap">{ ccsFormatSize(s.FileSizeBytes) }</td>
		<td class="px-4 py-2 text-fg-muted text-xs whitespace-nowrap">
			if s.ProjectDisplay != "" {
				<span class="badge badge-accent">{ s.ProjectDisplay }</span>
			} else {
				<span class="muted">—</span>
			}
		</td>
		<td class="px-4 py-2 text-fg-muted text-xs whitespace-nowrap">
			if s.GitBranch != "" {
				<span class="badge badge-neutral">{ s.GitBranch }</span>
			} else {
				<span class="muted">—</span>
			}
		</td>
	</tr>
}

// ccsLoadMoreRow renders the "Load more" trigger row.
templ ccsLoadMoreRow(cursor string, params services.CCSessionListParams, lang string) {
	<tr id="cc-sessions-load-more-row">
		<td colspan="7" class="px-4 py-3">
			<button
				class="btn btn-secondary btn-sm"
				hx-get={ ccsNextURL(cursor, params) }
				hx-target="#cc-sessions-tbody"
				hx-swap="beforeend"
				hx-on::after-request="document.getElementById('cc-sessions-load-more-row')?.remove()"
			>
				{ T(lang, "common.loadMore") }
			</button>
		</td>
	</tr>
}

// ---------------------------------------------------------------------------
// Helper functions
// ---------------------------------------------------------------------------

// ccsPromptPreview truncates the prompt for the table preview.
func ccsPromptPreview(s string) string {
	runes := []rune(s)
	// Remove newlines for single-line display.
	for i, r := range runes {
		if r == '\n' || r == '\r' {
			runes[i] = ' '
		}
	}
	max := 80
	if len(runes) <= max {
		return string(runes)
	}
	return string(runes[:max]) + "…"
}

// ccsPromptOneLine collapses whitespace but does NOT truncate — the First prompt
// column is the most important one and is shown in full (no ellipsis).
func ccsPromptOneLine(s string) string {
	return strings.Join(strings.Fields(s), " ")
}

// ccsFormatTokens renders a token count compactly (e.g. 850, 12.3k, 1.45M).
func ccsFormatTokens(n int64) string {
	switch {
	case n <= 0:
		return "—"
	case n < 1000:
		return fmt.Sprintf("%d", n)
	case n < 1_000_000:
		return fmt.Sprintf("%.1fk", float64(n)/1000)
	default:
		return fmt.Sprintf("%.2fM", float64(n)/1_000_000)
	}
}

// ccsFormatCost renders the computed USD cost. A trailing "~" marks sessions
// whose total includes assistant turns on a model absent from the pricing table
// (those turns were priced at 0, so the figure is a lower bound).
func ccsFormatCost(u services.CCSessionUsage) string {
	if u.CostUSD <= 0 {
		return "—"
	}
	var s string
	if u.CostUSD < 0.01 {
		s = "<$0.01"
	} else {
		s = fmt.Sprintf("$%.2f", u.CostUSD)
	}
	if u.UnknownModel {
		s += "~" // some turns used an unpriced model → lower bound
	}
	return s
}

// ccsTokensBreakdown is the hover tooltip for the tokens cell.
func ccsTokensBreakdown(u services.CCSessionUsage, lang string) string {
	return fmt.Sprintf("%s %d · %s %d · %s %d · %s %d",
		T(lang, "ccSessions.usage.input"), u.InputTokens,
		T(lang, "ccSessions.usage.output"), u.OutputTokens,
		T(lang, "ccSessions.usage.cacheWrite"), u.CacheWrite5m+u.CacheWrite1h,
		T(lang, "ccSessions.usage.cacheRead"), u.CacheRead,
	)
}

// ccsFormatTime formats a time.Time for display in the table.
func ccsFormatTime(t interface{ IsZero() bool; Format(string) string }) string {
	if t.IsZero() {
		return "—"
	}
	return t.Format("2006-01-02 15:04")
}

// ccsFormatDate renders just the date as dd-mm-yyyy (top line of the time cell).
func ccsFormatDate(t interface {
	IsZero() bool
	Format(string) string
}) string {
	if t.IsZero() {
		return "—"
	}
	return t.Format("02-01-2006")
}

// ccsFormatClock renders just the time as HH:MM (second line of the time cell).
func ccsFormatClock(t interface {
	IsZero() bool
	Format(string) string
}) string {
	if t.IsZero() {
		return ""
	}
	return t.Format("15:04")
}

// ccsFormatSize formats a file size in human-readable form.
func ccsFormatSize(bytes int64) string {
	switch {
	case bytes < 1024:
		return fmt.Sprintf("%d B", bytes)
	case bytes < 1024*1024:
		return fmt.Sprintf("%d KB", bytes/1024)
	default:
		return fmt.Sprintf("%.1f MB", float64(bytes)/(1024*1024))
	}
}

// ccsNextURL builds the load-more URL preserving current filters and the new cursor.
func ccsNextURL(cursor string, params services.CCSessionListParams) string {
	v := url.Values{}
	v.Set("cursor", cursor)
	v.Set("append", "true")
	if params.Project != "" {
		v.Set("project", params.Project)
	}
	return "/cc-sessions/list?" + v.Encode()
}
