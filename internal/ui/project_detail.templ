package ui

import (
	"fmt"
	"net/url"

	"github.com/AlvaroQ/engram-explorer/internal/services"
)

// ProjectDetailPage renders the full project-detail page shell.
templ ProjectDetailPage(data services.ProjectOverview, sync *services.SyncProjectRow, lang, theme, sidebarState string, otherProjects []string) {
	@Layout(data.Project, "projects", lang, theme, sidebarState, projectDetailContent(data, sync, lang, otherProjects))
}

// ProjectDetailPartial renders only the project-detail content (no HTML shell).
// Used when HTMX requests a partial update.
templ ProjectDetailPartial(data services.ProjectOverview, sync *services.SyncProjectRow, lang string, otherProjects []string) {
	@projectDetailContent(data, sync, lang, otherProjects)
}

// projectDetailContent is the shared project-detail body.
templ projectDetailContent(data services.ProjectOverview, sync *services.SyncProjectRow, lang string, otherProjects []string) {
	<div class="flex flex-col gap-5">
		<!-- Page header -->
		<div class="page-header">
			<div>
				<a href="/projects" class="mb-1 inline-flex items-center gap-1 text-xs text-fg-muted hover:text-accent">
					← { T(lang, "projectDetail.allProjects") }
				</a>
				<h1>{ data.Project }</h1>
				<p>{ T(lang, "projectDetail.description") }</p>
			</div>
			<div class="flex items-center gap-2">
				<a
					href={ templ.SafeURL("/observations?project=" + url.QueryEscape(data.Project)) }
					class="inline-flex items-center gap-1 rounded-md border border-border bg-surface-2 px-3 py-1.5 text-xs text-fg-muted hover:text-fg"
				>
					{ T(lang, "projectDetail.allObservations") }
				</a>
				<a
					href={ templ.SafeURL("/sessions?project=" + url.QueryEscape(data.Project)) }
					class="inline-flex items-center gap-1 rounded-md border border-border bg-surface-2 px-3 py-1.5 text-xs text-fg-muted hover:text-fg"
				>
					{ T(lang, "projectDetail.allSessions") }
				</a>
				if sync != nil && sync.Enrolled {
					<a
						href={ templ.SafeURL("/doctor/sync/" + url.PathEscape(data.Project)) }
						class="inline-flex items-center gap-1 rounded-md border border-border bg-surface-2 px-3 py-1.5 text-xs text-fg-muted hover:text-fg"
					>
						{ T(lang, "projectDetail.syncDetail") }
					</a>
				}
			</div>
		</div>
		<!-- KPI grid -->
		@projectDetailKPIs(data, sync, lang)
		<!-- Charts row: activity (2/3) + type breakdown (1/3) -->
		<div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
			<div class="card flex flex-col lg:col-span-2">
				<div class="card-header">
					<div>
						<h2>{ T(lang, "projectDetail.activity.title") }</h2>
						<p>{ T(lang, "projectDetail.activity.description") }</p>
					</div>
				</div>
				<div class="card-body" style="height:300px">
					@Island("project-activity-chart", toProjectActivityChartProps(data.Activity30d))
				</div>
			</div>
			<div class="card flex flex-col">
				<div class="card-header">
					<div>
						<h2>{ T(lang, "projectDetail.byType.title") }</h2>
						<p>{ T(lang, "projectDetail.byType.description") }</p>
					</div>
				</div>
				<div class="card-body" style="height:280px">
					@Island("type-breakdown", TypeBreakdownIslandProps{ByType: toTypeBreakdownEntries(data.ByType)})
				</div>
			</div>
		</div>
		<!-- Tools + Topics row -->
		<div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
			<div class="card">
				<div class="card-header">
					<div>
						<h2>{ T(lang, "projectDetail.tools.title") }</h2>
						<p>{ T(lang, "projectDetail.tools.description") }</p>
					</div>
				</div>
				<div class="card-body">
					@projectDetailToolList(data.ByTool, lang)
				</div>
			</div>
			<div class="card">
				<div class="card-header">
					<div>
						<h2>{ T(lang, "projectDetail.topics.title") }</h2>
						<p>{ T(lang, "projectDetail.topics.description") }</p>
					</div>
				</div>
				<div class="card-body">
					@projectDetailTopicList(data.TopTopics, data.Project, lang)
				</div>
			</div>
		</div>
		<!-- Recent sessions + Recent observations row -->
		<div class="grid grid-cols-1 gap-5 lg:grid-cols-2">
			<div class="card">
				<div class="card-header">
					<div>
						<h2>{ T(lang, "projectDetail.recentSessions.title") }</h2>
						<p>{ T(lang, "projectDetail.recentSessions.description", "shown", fmt.Sprintf("%d", len(data.RecentSessions)), "total", fmt.Sprintf("%d", data.KPIs.Sessions)) }</p>
					</div>
				</div>
				<div class="card-body p-0">
					@projectDetailRecentSessions(data.RecentSessions, lang)
				</div>
			</div>
			<div class="card">
				<div class="card-header">
					<div>
						<h2>{ T(lang, "projectDetail.recentObservations.title") }</h2>
						<p>{ T(lang, "projectDetail.recentObservations.description", "count", fmt.Sprintf("%d", len(data.RecentObservations))) }</p>
					</div>
				</div>
				<div class="card-body p-0">
					@projectDetailRecentObservations(data.RecentObservations, data.Project, lang)
				</div>
			</div>
		</div>
		<!-- Recent prompts (shown only when non-empty) -->
		if len(data.RecentPrompts) > 0 {
			<div class="card">
				<div class="card-header">
					<div>
						<h2>{ T(lang, "projectDetail.recentPrompts.title") }</h2>
					</div>
				</div>
				<div class="card-body space-y-2">
					for _, p := range data.RecentPrompts {
						<article class="rounded-md border border-border bg-surface-2 p-3">
							<p class="font-mono text-xs text-fg-muted">{ derefStr(p.CreatedAt, "—") }</p>
							<p class="mt-1 line-clamp-3 whitespace-pre-wrap text-sm text-fg">{ derefStr(p.Content, T(lang, "common.empty")) }</p>
						</article>
					}
				</div>
			</div>
		}
		<!-- Combine with another project -->
		@projectDetailCombineCard(data.Project, otherProjects, lang)
	</div>
}

// projectDetailKPIs renders the 5-card KPI grid (obs, sessions, topics, prompts, sync).
templ projectDetailKPIs(data services.ProjectOverview, sync *services.SyncProjectRow, lang string) {
	<div class="kpi-grid grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-5">
		@projectDetailKPICard(T(lang, "projectDetail.kpi.observations"), fmt.Sprintf("%d", data.KPIs.Observations))
		@projectDetailKPICard(T(lang, "projectDetail.kpi.sessions"), fmt.Sprintf("%d", data.KPIs.Sessions))
		@projectDetailKPICard(T(lang, "projectDetail.kpi.topics"), fmt.Sprintf("%d", data.KPIs.Topics))
		@projectDetailKPICard(T(lang, "projectDetail.kpi.prompts"), fmt.Sprintf("%d", data.KPIs.Prompts))
		<!-- Sync KPI card -->
		<div class="card">
			<div class="card-body">
				<p class="kpi-label">{ T(lang, "projectDetail.kpi.sync") }</p>
				<div>
					if sync == nil {
						<span class="badge badge-neutral">{ T(lang, "projectDetail.kpi.unknown") }</span>
					} else if !sync.Enrolled {
						<span class="badge badge-neutral">{ T(lang, "projectDetail.kpi.notEnrolled") }</span>
					} else if sync.Status == services.SyncStatusBroken {
						<span class="badge badge-fail">{ T(lang, "projectDetail.kpi.brokenPending", "count", fmt.Sprintf("%d", sync.PendingMutations)) }</span>
					} else if sync.Status == services.SyncStatusHealthy {
						<span class="badge badge-ok">{ T(lang, "projectDetail.kpi.healthy") }</span>
					} else {
						<span class="badge badge-warn">{ string(sync.Status) }</span>
					}
				</div>
				if sync != nil {
					<p class="kpi-sync-caption font-mono">
						{ T(lang, "projectDetail.kpi.ackedEnq",
							"acked", fmt.Sprintf("%d", derefInt64(sync.LastAckedSeq)),
							"enq", fmt.Sprintf("%d", derefInt64(sync.LastEnqueuedSeq))) }
					</p>
				}
			</div>
		</div>
	</div>
}

// projectDetailKPICard renders a single numeric KPI tile.
templ projectDetailKPICard(label, value string) {
	<div class="card">
		<div class="card-body">
			<p class="kpi-label">{ label }</p>
			<p class="kpi-value">{ value }</p>
		</div>
	</div>
}

// projectDetailToolList renders the by-tool list.
// The "(none)" bucket (observations with no tool_name, e.g. manual mem saves) is
// not a real tool, so it's filtered out; if nothing real remains the empty
// state is shown instead of a meaningless "(none)" row.
templ projectDetailToolList(tools []services.ToolCount, lang string) {
	{{ realTools := filterRealTools(tools) }}
	if len(realTools) == 0 {
		<p class="text-sm text-fg-muted">{ T(lang, "projectDetail.tools.empty") }</p>
	} else {
		<ul class="space-y-1.5">
			for _, t := range realTools {
				<li class="flex items-center justify-between gap-2">
					<span class="truncate font-mono text-xs text-fg">{ t.ToolName }</span>
					<span class="badge badge-neutral">{ fmt.Sprintf("%d", t.Count) }</span>
				</li>
			}
		</ul>
	}
}

// projectDetailTopicList renders the top-topics list.
// Topics link to the observations page (still React) via external href.
templ projectDetailTopicList(topics []services.TopicSummary, project string, lang string) {
	if len(topics) == 0 {
		<p class="text-sm text-fg-muted">{ T(lang, "projectDetail.topics.empty") }</p>
	} else {
		<ul class="space-y-1.5">
			for _, tt := range topics {
				<li class="flex items-center justify-between gap-2">
					<a
						href={ templ.SafeURL("/observations?project=" + url.QueryEscape(project) + "&topic_key=" + url.QueryEscape(tt.TopicKey)) }
						class="truncate font-mono text-xs text-accent hover:underline"
					>
						{ tt.TopicKey }
					</a>
					<span class="badge badge-neutral">{ fmt.Sprintf("%d", tt.ObsCount) }</span>
				</li>
			}
		</ul>
	}
}

// projectDetailRecentSessions renders the recent-sessions list.
templ projectDetailRecentSessions(sessions []services.RecentSession, lang string) {
	if len(sessions) == 0 {
		<p class="p-4 text-sm text-fg-muted">{ T(lang, "projectDetail.recentSessions.empty") }</p>
	} else {
		<ul class="divide-y divide-border">
			for _, s := range sessions {
				<li>
					<a href={ templ.SafeURL("/sessions/" + url.PathEscape(s.ID)) } class="block px-4 py-2.5 hover:bg-surface-2">
						<p class="truncate font-mono text-xs text-fg">{ s.ID }</p>
						<p class="text-xs text-fg-muted">
							{ derefStr(s.StartedAt, "—") }
							· { T(lang, "projectDetail.recentSessions.obsCount", "count", fmt.Sprintf("%d", s.ObsCount)) }
						</p>
						if s.Summary != nil && *s.Summary != "" {
							<p class="mt-1 line-clamp-2 text-xs text-fg-muted">{ *s.Summary }</p>
						}
					</a>
				</li>
			}
		</ul>
	}
}

// projectDetailRecentObservations renders the recent-observations list.
// "Open in Observations" links to the React SPA observations page (external href).
templ projectDetailRecentObservations(obs []services.RecentObs, project string, lang string) {
	if len(obs) == 0 {
		<p class="p-4 text-sm text-fg-muted">{ T(lang, "projectDetail.recentObservations.empty") }</p>
	} else {
		<ul class="divide-y divide-border">
			for _, o := range obs {
				<li class="flex items-center justify-between gap-2 px-4 py-2">
					<div class="min-w-0">
						<p class="truncate text-sm text-fg">{ derefStr(o.Title, T(lang, "common.untitled")) }</p>
						<p class="font-mono text-xs text-fg-muted">
							{ derefStr(o.CreatedAt, "—") }
							if o.ToolName != nil && *o.ToolName != "" {
								· { *o.ToolName }
							}
						</p>
					</div>
					<span class="badge badge-accent">{ o.Type }</span>
				</li>
			}
		</ul>
		<div class="border-t border-border p-3">
			<a
				href={ templ.SafeURL("/observations?project=" + url.QueryEscape(project)) }
				class="inline-flex items-center rounded-md border border-border bg-surface-2 px-3 py-1.5 text-xs text-fg-muted hover:text-fg"
			>
				{ T(lang, "projectDetail.recentObservations.openInObservations") }
			</a>
		</div>
	}
}

// projectDetailCombineCard renders the "Combine with another project" action card.
// otherProjects is the list of all project names except the current one.
// When empty it shows a disabled hint instead of a form.
templ projectDetailCombineCard(current string, otherProjects []string, lang string) {
	<div class="card">
		<div class="card-header">
			<div>
				<h2>{ T(lang, "projectDetail.combine.title") }</h2>
				<p>{ T(lang, "projectDetail.combine.description") }</p>
			</div>
		</div>
		<div class="card-body">
			if len(otherProjects) == 0 {
				<p class="text-sm text-fg-muted">{ T(lang, "projectDetail.combine.noTargets") }</p>
			} else {
				<form
					id="project-merge-form"
					hx-post={ "/projects/" + url.PathEscape(current) + "/merge" }
					hx-target="#project-merge-result"
					hx-swap="innerHTML"
					hx-confirm={ T(lang, "projectDetail.combine.confirm", "source", current, "target", "") }
					class="flex flex-col gap-3 sm:flex-row sm:items-end"
					onsubmit={ updateMergeConfirm(current) }
				>
					<div class="flex flex-col gap-1">
						<label for="merge-target" class="text-xs text-fg-muted">{ T(lang, "projectDetail.combine.targetLabel") }</label>
						<select
							id="merge-target"
							name="target"
							class="rounded-md border border-border bg-surface px-3 py-1.5 text-sm text-fg focus:border-accent focus:outline-none"
							required
						>
							for _, p := range otherProjects {
								<option value={ p }>{ p }</option>
							}
						</select>
					</div>
					<button
						type="submit"
						class="inline-flex items-center rounded-md border border-border bg-surface-2 px-3 py-1.5 text-sm text-fg-muted hover:border-fail hover:text-fail"
					>
						{ T(lang, "projectDetail.combine.submit") }
					</button>
				</form>
				<div id="project-merge-result" class="mt-3"></div>
			}
		</div>
	</div>
}

// updateMergeConfirm is a small script that patches the hx-confirm attribute
// with the selected target name right before the form submits, so the
// confirmation dialog shows the real project name rather than an empty string.
script updateMergeConfirm(source string) {
	const sel = document.getElementById("merge-target");
	if (sel) {
		const target = sel.value;
		const form = document.getElementById("project-merge-form");
		if (form) {
			form.setAttribute("hx-confirm",
				"Combine \"" + source + "\" into \"" + target + "\"? This moves all its memories and cannot be undone."
			);
		}
	}
}

// ---------------------------------------------------------------------------
// Helper functions
// ---------------------------------------------------------------------------

// derefInt64 dereferences a *int64; returns 0 if nil.
func derefInt64(n *int64) int64 {
	if n == nil {
		return 0
	}
	return *n
}

// filterRealTools drops the synthetic "(none)" bucket (observations with a NULL
// tool_name, produced by the COALESCE in services.ProjectOverview's by-tool
// query) so the Tools card only lists actual tools.
func filterRealTools(tools []services.ToolCount) []services.ToolCount {
	out := make([]services.ToolCount, 0, len(tools))
	for _, t := range tools {
		if t.ToolName == "" || t.ToolName == "(none)" {
			continue
		}
		out = append(out, t)
	}
	return out
}
