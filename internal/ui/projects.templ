package ui

import (
	"fmt"
	"net/url"

	"github.com/AlvaroQ/engram-explorer/internal/services"
)

// ProjectsListPage renders the full page shell for the projects list view.
templ ProjectsListPage(stats []services.ProjectStats, sync services.SyncProjectsResponse, caps services.CloudCapabilities, q, lang, theme, sidebarState string) {
	@Layout(T(lang, "projects.title"), "projects", lang, theme, sidebarState, projectsContent(stats, sync, caps, q, lang))
}

// ProjectsListPartial renders only the projects content (no HTML shell).
// Used when HTMX requests a partial update.
templ ProjectsListPartial(stats []services.ProjectStats, sync services.SyncProjectsResponse, caps services.CloudCapabilities, q, lang string) {
	@projectsContent(stats, sync, caps, q, lang)
}

// projectsContent is the shared projects body.
templ projectsContent(stats []services.ProjectStats, sync services.SyncProjectsResponse, caps services.CloudCapabilities, q, lang string) {
	<div>
		<div class="page-header">
			<h1>{ T(lang, "projects.title") }</h1>
			<p>{ T(lang, "projects.description") }</p>
		</div>
		<div class="card">
			<div class="card-header">
				<div>
					<h2>{ T(lang, "projects.all") }</h2>
					<p>{ T(lang, "projects.count", "count", fmt.Sprintf("%d", len(stats))) }</p>
				</div>
				<div class="search-input-wrap">
					<input
						class="input"
						type="search"
						name="q"
						value={ q }
						placeholder={ T(lang, "projects.filterPlaceholder") }
						hx-get="/projects/list"
						hx-trigger="keyup changed delay:300ms"
						hx-target="#projects-table-container"
						hx-include="[name='q']"
					/>
				</div>
			</div>
			<div class="card-body p-0" id="projects-table-container">
				@ProjectsTablePartial(stats, sync, caps, q, lang)
			</div>
		</div>
	</div>
}

// ProjectsTablePartial renders only the projects table body (HTMX swap target).
templ ProjectsTablePartial(stats []services.ProjectStats, sync services.SyncProjectsResponse, caps services.CloudCapabilities, q, lang string) {
	if len(stats) == 0 {
		@EmptyState(T(lang, "projects.noMatch"))
	} else {
		<div class="overflow-x-auto">
			<table class="w-full text-sm">
				<thead class="table-head">
					<tr>
						<th class="px-3 py-2 text-left">{ T(lang, "projects.table.project") }</th>
						<th class="px-3 py-2 text-left">{ T(lang, "projects.table.observations") }</th>
						<th class="px-3 py-2 text-left">{ T(lang, "projects.table.sessions") }</th>
						<th class="px-3 py-2 text-left">{ T(lang, "projects.table.prompts") }</th>
						<th class="px-3 py-2 text-left">{ T(lang, "projects.table.lastActivity") }</th>
						<th class="px-3 py-2 text-left">{ T(lang, "projects.table.syncLag") }</th>
						<th class="px-3 py-2 text-left">{ T(lang, "projects.table.sync") }</th>
						<th class="px-3 py-2 text-right">{ T(lang, "syncHealth.projects.table.actions") }</th>
					</tr>
				</thead>
				<tbody class="table-divide">
					for _, p := range stats {
						@projectRow(p, syncByProject(sync, p.Project), caps, lang)
					}
				</tbody>
			</table>
		</div>
	}
}

// projectRow renders a single project table row.
templ projectRow(p services.ProjectStats, syncRow *services.SyncProjectRow, caps services.CloudCapabilities, lang string) {
	<tr class="hover:bg-surface-2">
		<td class="px-3 py-2">
			if p.Project == "" {
				<a href="/doctor/orphans" class="mono text-xs text-fail hover:underline">{ T(lang, "common.emptyNameBug") }</a>
			} else {
				<a href={ templ.SafeURL("/projects/" + url.PathEscape(p.Project)) } class="font-medium text-fg hover:text-accent">{ p.Project }</a>
			}
		</td>
		<td class="px-3 py-2 text-fg-muted">{ fmt.Sprintf("%d", p.ObsCount) }</td>
		<td class="px-3 py-2 text-fg-muted">{ fmt.Sprintf("%d", p.SessionsCount) }</td>
		<td class="px-3 py-2 text-fg-muted">{ fmt.Sprintf("%d", p.PromptsCount) }</td>
		<td class="px-3 py-2 mono text-xs text-fg-muted">{ derefOrDash(p.LastActivity) }</td>
		<td class="px-3 py-2">
			@syncLagCell(syncRow != nil && syncRow.Enrolled, p.PendingMutations, p.SyncUpdatedAt, lang)
		</td>
		<td class="px-3 py-2">
			@syncStatusCell(syncRow, lang)
		</td>
		<td class="px-3 py-2 text-right">
			if p.Project != "" {
				@enrollUnenrollButton(p.Project, syncRow != nil && syncRow.Enrolled, caps, lang)
			}
		</td>
	</tr>
}

// syncLagCell renders the sync-lag column.
templ syncLagCell(enrolled bool, pending int64, syncUpdatedAt *string, lang string) {
	if !enrolled || syncUpdatedAt == nil {
		<span class="text-xs text-fg-muted">{ T(lang, "projects.syncLag.noSync") }</span>
	} else if pending == 0 {
		<span class="inline-flex items-center gap-1.5 text-xs text-ok">
			<span class="h-1.5 w-1.5 rounded-full bg-ok" aria-hidden="true"></span>
			{ T(lang, "projects.syncLag.fresh") }
		</span>
	} else {
		<span class="inline-flex items-center gap-2 text-xs">
			<span class="badge badge-fail">{ fmt.Sprintf("%d", pending) }</span>
		</span>
	}
}

// syncStatusCell renders the sync-status badge column.
templ syncStatusCell(syncRow *services.SyncProjectRow, lang string) {
	if syncRow == nil || !syncRow.Enrolled {
		<span class="badge badge-neutral">{ T(lang, "projects.syncBadge.notEnrolled") }</span>
	} else if syncRow.Status == services.SyncStatusBroken {
		<span class="badge badge-fail">{ T(lang, "projects.syncBadge.broken") }</span>
	} else if syncRow.Status == services.SyncStatusDegraded {
		<span class="badge badge-warn">{ T(lang, "projects.syncBadge.degraded") }</span>
	} else if syncRow.Status == services.SyncStatusHealthy {
		<span class="badge badge-ok">{ T(lang, "projects.syncBadge.healthy") }</span>
	} else {
		<span class="badge badge-warn">{ string(syncRow.Status) }</span>
	}
}

// enrollUnenrollButton renders the enroll/unenroll action button.
// Uses hx-post to trigger the operation and hx-target to refresh the table.
templ enrollUnenrollButton(project string, enrolled bool, caps services.CloudCapabilities, lang string) {
	if enrolled {
		if caps.Unenroll {
			<button
				class="btn-icon text-fail"
				hx-post={ projectActionURL(project, "unenroll") }
				hx-target="#projects-table-container"
				hx-swap="innerHTML"
				title={ T(lang, "syncHealth.projects.actions.unenroll") }
				aria-label={ T(lang, "syncHealth.projects.actions.unenroll") }
			>
				@cloudOffIcon()
			</button>
		} else {
			<button class="btn-icon text-fail opacity-40 cursor-not-allowed" disabled title={ T(lang, "syncHealth.projects.actions.unenrollUnsupported") }>
				@cloudOffIcon()
			</button>
		}
	} else {
		if caps.Enroll {
			<button
				class="btn-icon text-accent"
				hx-post={ projectActionURL(project, "enroll") }
				hx-target="#projects-table-container"
				hx-swap="innerHTML"
				title={ T(lang, "syncHealth.projects.actions.enroll") }
				aria-label={ T(lang, "syncHealth.projects.actions.enroll") }
			>
				@cloudUploadIcon()
			</button>
		} else {
			<button class="btn-icon text-accent opacity-40 cursor-not-allowed" disabled title={ T(lang, "syncHealth.projects.actions.enrollUnsupported") }>
				@cloudUploadIcon()
			</button>
		}
	}
}

// cloudUploadIcon is the enroll action glyph: a cloud with an upward arrow,
// signalling "enroll this project into Engram cloud sync". Stroke style matches
// the sidebar-sync-icon in layout.templ.
templ cloudUploadIcon() {
	<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M12 13v8"></path>
		<path d="m8 17 4-4 4 4"></path>
		<path d="M4.5 16.5a4.5 4.5 0 0 1 1-8.86A6 6 0 0 1 17 8a4.5 4.5 0 0 1 2 8.5"></path>
	</svg>
}

// cloudOffIcon is the unenroll action glyph: a cloud struck through, signalling
// "remove this project from Engram cloud sync". Stroke style matches the
// sidebar-sync-icon in layout.templ.
templ cloudOffIcon() {
	<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="m2 2 20 20"></path>
		<path d="M5.8 5.8A6 6 0 0 0 6 18h10.5a4.5 4.5 0 0 0 2.5-.76"></path>
		<path d="M9.5 6.5A6 6 0 0 1 17 8a4.5 4.5 0 0 1 2.55 8.18"></path>
	</svg>
}

// ---------------------------------------------------------------------------
// Template helper functions
// ---------------------------------------------------------------------------

// syncByProject finds the SyncProjectRow for a given project name from the response.
func syncByProject(sync services.SyncProjectsResponse, project string) *services.SyncProjectRow {
	for i := range sync.Projects {
		if sync.Projects[i].Project == project {
			return &sync.Projects[i]
		}
	}
	return nil
}

// derefOrDash dereferences a *string; returns "—" when nil or empty.
func derefOrDash(s *string) string {
	if s == nil || *s == "" {
		return "—"
	}
	return *s
}

// projectActionURL builds the URL for enroll/unenroll POST actions.
func projectActionURL(project, action string) string {
	return "/projects/" + url.PathEscape(project) + "/" + action
}
