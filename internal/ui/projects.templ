package ui

import (
	"fmt"
	"net/url"

	"github.com/AlvaroQ/engram-explorer/internal/services"
)

// ProjectsListPage renders the full page shell for the projects list view.
templ ProjectsListPage(stats []services.ProjectStats, sync services.SyncProjectsResponse, q, lang, theme, sidebarState string) {
	@Layout(T(lang, "projects.title"), "projects", lang, theme, sidebarState, projectsContent(stats, sync, q, lang))
}

// ProjectsListPartial renders only the projects content (no HTML shell).
// Used when HTMX requests a partial update.
templ ProjectsListPartial(stats []services.ProjectStats, sync services.SyncProjectsResponse, q, lang string) {
	@projectsContent(stats, sync, q, lang)
}

// projectsContent is the shared projects body.
templ projectsContent(stats []services.ProjectStats, sync services.SyncProjectsResponse, q, lang string) {
	<div>
		<div class="page-header">
			<h1>{ T(lang, "projects.title") }</h1>
			<p>{ T(lang, "projects.description") }</p>
		</div>
		<div class="card">
			<div class="card-header">
				<div>
					<h2>{ T(lang, "projects.all") }</h2>
					<p>{ T(lang, "projects.count", "count", fmt.Sprintf("%d", len(stats))) }</p>
				</div>
				<div class="search-input-wrap">
					<input
						class="input"
						type="search"
						name="q"
						value={ q }
						placeholder={ T(lang, "projects.filterPlaceholder") }
						hx-get="/projects/list"
						hx-trigger="keyup changed delay:300ms"
						hx-target="#projects-table-container"
						hx-include="[name='q']"
					/>
				</div>
			</div>
			<div class="card-body p-0" id="projects-table-container">
				@ProjectsTablePartial(stats, sync, q, lang)
			</div>
		</div>
	</div>
}

// ProjectsTablePartial renders only the projects table body (HTMX swap target).
templ ProjectsTablePartial(stats []services.ProjectStats, sync services.SyncProjectsResponse, q, lang string) {
	if len(stats) == 0 {
		@EmptyState(T(lang, "projects.noMatch"))
	} else {
		<div class="overflow-x-auto">
			<table class="w-full text-sm">
				<thead class="table-head">
					<tr>
						<th class="px-3 py-2 text-left">{ T(lang, "projects.table.project") }</th>
						<th class="px-3 py-2 text-left">{ T(lang, "projects.table.observations") }</th>
						<th class="px-3 py-2 text-left">{ T(lang, "projects.table.sessions") }</th>
						<th class="px-3 py-2 text-left">{ T(lang, "projects.table.prompts") }</th>
						<th class="px-3 py-2 text-left">{ T(lang, "projects.table.lastActivity") }</th>
						<th class="px-3 py-2 text-left">{ T(lang, "projects.table.syncLag") }</th>
						<th class="px-3 py-2 text-left">{ T(lang, "projects.table.sync") }</th>
					</tr>
				</thead>
				<tbody class="table-divide">
					for _, p := range stats {
						@projectRow(p, syncByProject(sync, p.Project), lang)
					}
				</tbody>
			</table>
		</div>
	}
}

// projectRow renders a single project table row. Enrollment is shown as a
// read-only status badge; cloud mutations are done with the engram CLI.
templ projectRow(p services.ProjectStats, syncRow *services.SyncProjectRow, lang string) {
	<tr class="hover:bg-surface-2">
		<td class="px-3 py-2">
			if p.Project == "" {
				<a href="/doctor/orphans" class="mono text-xs text-fail hover:underline">{ T(lang, "common.emptyNameBug") }</a>
			} else {
				<a href={ templ.SafeURL("/projects/" + url.PathEscape(p.Project)) } class="font-medium text-fg hover:text-accent">{ p.Project }</a>
			}
		</td>
		<td class="px-3 py-2 text-fg-muted">{ fmt.Sprintf("%d", p.ObsCount) }</td>
		<td class="px-3 py-2 text-fg-muted">{ fmt.Sprintf("%d", p.SessionsCount) }</td>
		<td class="px-3 py-2 text-fg-muted">{ fmt.Sprintf("%d", p.PromptsCount) }</td>
		<td class="px-3 py-2 mono text-xs text-fg-muted">{ derefOrDash(p.LastActivity) }</td>
		<td class="px-3 py-2">
			@syncLagCell(syncRow != nil && syncRow.Enrolled, p.PendingMutations, p.SyncUpdatedAt, lang)
		</td>
		<td class="px-3 py-2">
			@syncStatusCell(syncRow, lang)
		</td>
	</tr>
}

// syncLagCell renders the sync-lag column.
templ syncLagCell(enrolled bool, pending int64, syncUpdatedAt *string, lang string) {
	if !enrolled || syncUpdatedAt == nil {
		<span class="text-xs text-fg-muted">{ T(lang, "projects.syncLag.noSync") }</span>
	} else if pending == 0 {
		<span class="inline-flex items-center gap-1.5 text-xs text-ok">
			<span class="h-1.5 w-1.5 rounded-full bg-ok" aria-hidden="true"></span>
			{ T(lang, "projects.syncLag.fresh") }
		</span>
	} else {
		<span class="inline-flex items-center gap-2 text-xs">
			<span class="badge badge-fail">{ fmt.Sprintf("%d", pending) }</span>
		</span>
	}
}

// syncStatusCell renders the sync-status badge column.
templ syncStatusCell(syncRow *services.SyncProjectRow, lang string) {
	if syncRow == nil || !syncRow.Enrolled {
		<span class="badge badge-neutral">{ T(lang, "projects.syncBadge.notEnrolled") }</span>
	} else if syncRow.Status == services.SyncStatusBroken {
		<span class="badge badge-fail">{ T(lang, "projects.syncBadge.broken") }</span>
	} else if syncRow.Status == services.SyncStatusDegraded {
		<span class="badge badge-warn">{ T(lang, "projects.syncBadge.degraded") }</span>
	} else if syncRow.Status == services.SyncStatusHealthy {
		<span class="badge badge-ok">{ T(lang, "projects.syncBadge.healthy") }</span>
	} else {
		<span class="badge badge-warn">{ string(syncRow.Status) }</span>
	}
}

// ---------------------------------------------------------------------------
// Template helper functions
// ---------------------------------------------------------------------------

// syncByProject finds the SyncProjectRow for a given project name from the response.
func syncByProject(sync services.SyncProjectsResponse, project string) *services.SyncProjectRow {
	for i := range sync.Projects {
		if sync.Projects[i].Project == project {
			return &sync.Projects[i]
		}
	}
	return nil
}

// derefOrDash dereferences a *string; returns "—" when nil or empty.
func derefOrDash(s *string) string {
	if s == nil || *s == "" {
		return "—"
	}
	return *s
}
