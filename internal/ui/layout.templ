package ui

import (
	"context"
	"strings"

	"github.com/AlvaroQ/engram-explorer/internal/providers"
)

// Layout renders the full HTML shell with sidebar navigation and a padded main content area.
// activeNav should match one of the nav item keys (e.g. "topics", "observations").
// sidebarState is "expanded" or "collapsed" (server-side initial state, read from cookie;
// anything but "expanded" renders the 64px rail).
templ Layout(title, activeNav, lang, theme, sidebarState string, content templ.Component) {
	<!DOCTYPE html>
	<html class={ theme } data-theme={ theme } lang={ lang }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<!-- htmx never evaluates attribute code (hx-on, trigger filters, js:):
			     the CSP has no 'unsafe-eval' and behaviours live in ui-actions.js.
			     includeIndicatorStyles:false stops htmx injecting a <style> element
			     (style-src is 'self'); styles.css carries the indicator rules. -->
			<meta name="htmx-config" content='{"allowEval":false,"includeIndicatorStyles":false}'/>
			<title>{ title } — Engram</title>
			<link rel="stylesheet" href="/static/tokens.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="stylesheet" href="/static/styles.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/ui-actions.js" defer></script>
			<!-- Island loader: mounts React components declared with data-island.
			     Only fetches island bundles when [data-island] elements are present. -->
			<script type="module" src="/islands/loader.js"></script>
		</head>
		<body>
			<a class="skip-link" href="#main-content">{ T(lang, "common.skipToContent") }</a>
			<!-- Scrim for modal drawer on compact viewports -->
			<div class="sidebar-scrim" id="sidebar-scrim" aria-hidden="true"></div>
			<div class={ "app-shell", templ.KV("sidebar-collapsed", railCollapsed(sidebarState)) }>
				@Sidebar(activeNav, lang, sidebarState)
				<main class="main-content" id="main-content" tabindex="-1">
					@content
				</main>
			</div>
			<script src="/static/sidebar.js" defer></script>
		</body>
	</html>
}

// LayoutFullBleed renders the full HTML shell with sidebar navigation but WITHOUT
// padding on the main content area. Used for pages that need edge-to-edge content
// (e.g. the brain 3D canvas).
// sidebarState is "expanded" or "collapsed" (server-side initial state, read from cookie;
// anything but "expanded" renders the 64px rail).
templ LayoutFullBleed(title, activeNav, lang, theme, sidebarState string, content templ.Component) {
	<!DOCTYPE html>
	<html class={ theme } data-theme={ theme } lang={ lang }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="htmx-config" content='{"allowEval":false,"includeIndicatorStyles":false}'/>
			<title>{ title } — Engram</title>
			<link rel="stylesheet" href="/static/tokens.css"/>
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="stylesheet" href="/static/styles.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/ui-actions.js" defer></script>
			<script type="module" src="/islands/loader.js"></script>
		</head>
		<body>
			<a class="skip-link" href="#main-content">{ T(lang, "common.skipToContent") }</a>
			<!-- Scrim for modal drawer on compact viewports -->
			<div class="sidebar-scrim" id="sidebar-scrim" aria-hidden="true"></div>
			<div class={ "app-shell", templ.KV("sidebar-collapsed", railCollapsed(sidebarState)) }>
				@Sidebar(activeNav, lang, sidebarState)
				<main class="main-content-full" id="main-content" tabindex="-1">
					@content
				</main>
			</div>
			<script src="/static/sidebar.js" defer></script>
		</body>
	</html>
}

// Sidebar renders the primary navigation sidebar.
// activeNav is compared against each item's key to mark the active link.
// sidebarState is "expanded" or "collapsed" (initial state from cookie, may be
// overridden client-side by sidebar.js).
// The sidebar is data-driven from the NavGroups in ctx (injected by renderDeps
// via NavContextWithGroups); without them it renders legacyNavGroups.
templ Sidebar(activeNav, lang, sidebarState string) {
	<aside
		class={ "sidebar", templ.KV("sidebar--collapsed", railCollapsed(sidebarState)) }
		id="sidebar"
		aria-label={ T(lang, "sidebar.primaryNav") }
	>
		<div class="sidebar-brand">
			<div class="sidebar-brand-text">
				<h1 class="sidebar-brand-title">{ T(lang, "sidebar.brand") }</h1>
				if profiles := profilesFromContext(ctx); len(profiles) > 1 {
					@accountSwitcher(lang, profiles)
				} else {
					<p class="sidebar-brand-label">{ T(lang, "sidebar.subtitle") }</p>
				}
			</div>
			<div class="sidebar-brand-actions">
				<!-- Collapse/expand toggle -->
				<button
					type="button"
					class="sidebar-toggle"
					id="sidebar-toggle"
					aria-label={ sidebarToggleLabel(lang, sidebarState) }
					if railCollapsed(sidebarState) {
						aria-expanded="false"
					} else {
						aria-expanded="true"
					}
					aria-controls="sidebar"
					data-label-expand={ T(lang, "sidebar.expand") }
					data-label-collapse={ T(lang, "sidebar.collapse") }
				>
					@menuIcon()
				</button>
				@sidebarSettingsIcon(activeNav, T(lang, "sidebar.settings"))
			</div>
		</div>
		<nav class="sidebar-nav-wrap" id="sidebar-nav" hx-preserve="true">
			// Data-driven from the registry NavGroups (legacyNavGroups when
			// the page was rendered without a registry).
			if groups := sidebarGroups(ctx); len(groups) > 0 {
				for i, group := range groups {
					if links := sidebarLinks(ctx, group.Links); navShowGroup(ctx, group.ID) && len(links) > 0 {
						@sidebarGroup(T(lang, group.LabelKey), group.ID, group.Icon)
						<ul class="sidebar-nav">
							for _, link := range links {
								@sidebarLink(link.Href, T(lang, link.LabelKey), link.Icon, navLinkActive(ctx, link, activeNav))
							}
						</ul>
					}
					if i < len(groups)-1 {
						@sidebarDividerIfBothVisible(ctx, groups, i, lang)
					}
				}
			}
		</nav>
		@sidebarFooter(lang)
	</aside>
}

// menuIcon renders the panel-left (lucide) icon for the sidebar toggle button —
// the de-facto signifier for collapsing/expanding a side panel. Works in all
// three responsive modes without state-dependent swapping.
templ menuIcon() {
	<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<rect width="18" height="18" x="3" y="3" rx="2"></rect>
		<path d="M9 3v18"></path>
	</svg>
}

// navIcon renders an inline SVG icon for a nav item by name.
// All icons use the lucide-style stroke convention:
// viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
// stroke-linecap="round" stroke-linejoin="round"
templ navIcon(name string) {
	switch name {
		case "overview":
			<svg class="nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<rect x="3" y="3" width="7" height="7" rx="1"></rect>
				<rect x="14" y="3" width="7" height="7" rx="1"></rect>
				<rect x="3" y="14" width="7" height="7" rx="1"></rect>
				<rect x="14" y="14" width="7" height="7" rx="1"></rect>
			</svg>
		case "brain":
			<svg class="nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.46 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 4.44-1.14Z"></path>
				<path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96-.46 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-4.44-1.14Z"></path>
			</svg>
		case "observations":
			<svg class="nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
				<circle cx="12" cy="12" r="3"></circle>
			</svg>
		case "sessions":
			<svg class="nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
			</svg>
		case "projects":
			<svg class="nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
			</svg>
		case "prompts":
			<svg class="nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<polyline points="4 17 10 11 4 5"></polyline>
				<line x1="12" y1="19" x2="20" y2="19"></line>
			</svg>
		case "topics":
			<svg class="nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
				<line x1="7" y1="7" x2="7.01" y2="7"></line>
			</svg>
		case "syncHealth":
			<svg class="nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
			</svg>
		case "orphans":
			<svg class="nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
				<path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
				<line x1="2" y1="2" x2="22" y2="22"></line>
			</svg>
		case "agent-sessions":
			<svg class="nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
				<line x1="9" y1="10" x2="15" y2="10"></line>
			</svg>
		case "agent-sessions-overview":
			<svg class="nav-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
				<line x1="3" y1="9" x2="21" y2="9"></line>
				<line x1="9" y1="21" x2="9" y2="9"></line>
			</svg>
		case "agent-claude-code":
			<svg class="nav-icon nav-icon-claude-code" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
				<path d="M12 3.5v17M3.5 12h17M6 6l12 12M18 6L6 18"></path>
			</svg>
		case "agent-codex":
			<svg class="nav-icon nav-icon-codex" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<rect x="3" y="4.5" width="18" height="15" rx="2.5"></rect>
				<path d="M7.5 10l3 2.5-3 2.5M12.5 15.5h4"></path>
			</svg>
		default:
	}
}

// sidebarFooter renders the pinned bottom region of the sidebar: a live backend
// status pill (polled via HTMX).
templ sidebarFooter(lang string) {
	<div class="sidebar-footer">
		<div
			id="sidebar-status-pill"
			hx-get="/partials/status-pill"
			hx-trigger="load, every 30s"
			hx-swap="outerHTML"
		>
			@statusPill(statusPillData{Lang: lang, State: statusChecking})
		</div>
	</div>
}

// statusPill renders the backend health pill. The fragment carries no polling
// attributes itself — the polling wrapper (#sidebar-status-pill) owns the
// hx-trigger so the same component can be used for the initial server render
// and for each HTMX swap.
templ statusPill(d statusPillData) {
	<span
		class={ "status-pill", "status-pill--" + string(d.State) }
		title={ T(d.Lang, statusLabelKey(d.State)) }
		role="status"
		aria-live="polite"
	>
		<span class="status-pill-dot" aria-hidden="true"></span>
		<span class="status-pill-label">{ T(d.Lang, statusLabelKey(d.State)) }</span>
	</span>
}

// sidebarDividerIfBothVisible renders a divider between two sidebar groups
// only when both the current and next group are visible (cookie-check).
templ sidebarDividerIfBothVisible(ctx context.Context, groups []providers.NavGroup, idx int, lang string) {
	if navShowGroup(ctx, groups[idx].ID) && navShowGroup(ctx, groups[idx+1].ID) {
		<div class="sidebar-divider"></div>
	}
}

// sidebarGroup renders a section heading that introduces a group of nav links.
// variant (the group ID) selects the accent color CSS class; icon, when set,
// is the brand image shown in place of the accent dot (NavGroup.Icon).
templ sidebarGroup(label, variant, icon string) {
	<p class={ "sidebar-group-label sidebar-group-" + variant }>
		if icon != "" {
			<img src={ icon } class="sidebar-group-icon" alt="" aria-hidden="true"/>
		} else {
			<span class="sidebar-group-dot" aria-hidden="true"></span>
		}
		<span class="sidebar-group-text">{ label }</span>
	</p>
}

// accountSwitcher renders the profile switcher dropdown in the sidebar brand area.
// It is shown only when 2+ profiles exist (injected via context by renderDeps).
templ accountSwitcher(lang string, profiles []ProfileInfo) {
	<div class="account-switcher">
		if active := activeProfileFromProfiles(profiles); active != "" {
			<span class="account-avatar" aria-hidden="true">{ profileInitial(active) }</span>
			<span class="sidebar-brand-label">{ active }</span>
		}
		<div class="account-switcher-menu">
			for _, p := range profiles {
				if !p.Active {
					// Use hx-post without explicit hx-target/hx-swap:
					// handleProfileSwitchPost returns HX-Redirect on success so HTMX
					// performs a full client-side navigation without a jarring full-body
					// outerHTML swap.
					<form method="post" action="/settings/profile/switch"
						hx-post="/settings/profile/switch"
						hx-push-url="true">
						<input type="hidden" name="name" value={ p.Name }/>
						<button type="submit" class="account-switcher-item">
							{ p.Name }
						</button>
					</form>
				}
			}
			<a href="/settings/accounts" class="account-switcher-item account-switcher-manage">
				{ T(lang, "settings.accounts.manage") }
			</a>
		</div>
	</div>
}

// activeProfileFromProfiles returns the name of the active profile in the list.
func activeProfileFromProfiles(profiles []ProfileInfo) string {
	for _, p := range profiles {
		if p.Active {
			return p.Name
		}
	}
	return ""
}

// sidebarSettingsIcon renders the settings gear in the brand header.
// It is marked active when the settings page is open.
templ sidebarSettingsIcon(activeNav, label string) {
	<a
		href="/settings"
		class={ "sidebar-brand-settings", templ.KV("active", activeNav == "settings") }
		if activeNav == "settings" {
			aria-current="page"
		}
		aria-label={ label }
		title={ label }
	>
		<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="12" cy="12" r="3"></circle>
			<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
		</svg>
	</a>
}

// sidebarLink renders a navigation link with an optional icon. The active
// link carries class="active" (styling) and aria-current="page".
// The label stays in the DOM in the collapsed rail, where CSS turns it into
// a tooltip chip on hover and keyboard focus.
templ sidebarLink(href, label, icon string, active bool) {
	<li>
		if active {
			<a href={ templ.SafeURL(href) } class="active" aria-current="page" aria-label={ label }>
				if icon != "" {
					@navIcon(icon)
				}
				<span class="nav-label">{ label }</span>
			</a>
		} else {
			<a href={ templ.SafeURL(href) } aria-label={ label }>
				if icon != "" {
					@navIcon(icon)
				}
				<span class="nav-label">{ label }</span>
			</a>
		}
	</li>
}

// railCollapsed reports whether the shell starts as the 64px icon rail: every
// state but an explicit "expanded" (the default; pages that pass no state
// get the rail too).
func railCollapsed(sidebarState string) bool { return sidebarState != "expanded" }

// sidebarToggleLabel names the rail toggle by the action it performs now.
func sidebarToggleLabel(lang, sidebarState string) string {
	if railCollapsed(sidebarState) {
		return T(lang, "sidebar.expand")
	}
	return T(lang, "sidebar.collapse")
}

// profileInitial returns the upper-cased first letter of a profile name, shown
// as the account avatar in the collapsed rail.
func profileInitial(name string) string {
	for _, r := range name {
		return strings.ToUpper(string(r))
	}
	return ""
}
