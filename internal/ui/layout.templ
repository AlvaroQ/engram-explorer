package ui

// Layout renders the full HTML shell with sidebar navigation and a padded main content area.
// activeNav should match one of the nav item keys (e.g. "topics", "observations").
templ Layout(title, activeNav, lang, theme string, content templ.Component) {
	<!DOCTYPE html>
	<html class={ theme } data-theme={ theme } lang={ lang }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — Engram</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="stylesheet" href="/static/styles.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<!-- Island loader: mounts React components declared with data-island.
			     Only fetches island bundles when [data-island] elements are present. -->
			<script type="module" src="/islands/loader.js"></script>
		</head>
		<body>
			<div class="app-shell">
				@Sidebar(activeNav, lang)
				<main class="main-content">
					@content
				</main>
			</div>
		</body>
	</html>
}

// LayoutFullBleed renders the full HTML shell with sidebar navigation but WITHOUT
// padding on the main content area. Used for pages that need edge-to-edge content
// (e.g. the brain 3D canvas).
templ LayoutFullBleed(title, activeNav, lang, theme string, content templ.Component) {
	<!DOCTYPE html>
	<html class={ theme } data-theme={ theme } lang={ lang }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — Engram</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="stylesheet" href="/static/styles.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script type="module" src="/islands/loader.js"></script>
		</head>
		<body>
			<div class="app-shell">
				@Sidebar(activeNav, lang)
				<main class="main-content-full">
					@content
				</main>
			</div>
		</body>
	</html>
}

// Sidebar renders the primary navigation sidebar.
// activeNav is compared against each item's key to mark the active link.
templ Sidebar(activeNav, lang string) {
	<aside class="sidebar">
		<div class="sidebar-brand">
			<p class="sidebar-brand-label">{ T(lang, "sidebar.brand") }</p>
			<h1 class="sidebar-brand-title">{ T(lang, "sidebar.subtitle") }</h1>
		</div>
		<nav aria-label={ T(lang, "sidebar.primaryNav") }>
			<ul class="sidebar-nav">
				@sidebarLink("/", "overview", activeNav, T(lang, "sidebar.overview"))
				@sidebarLink("/brain", "brain", activeNav, T(lang, "sidebar.knowledge"))
				@sidebarLink("/observations", "observations", activeNav, T(lang, "sidebar.observations"))
				@sidebarLink("/sessions", "sessions", activeNav, T(lang, "sidebar.sessions"))
				@sidebarLink("/projects", "projects", activeNav, T(lang, "sidebar.projects"))
				@sidebarLink("/prompts", "prompts", activeNav, T(lang, "sidebar.prompts"))
				@sidebarLink("/topics", "topics", activeNav, T(lang, "sidebar.topics"))
				@sidebarLink("/settings", "settings", activeNav, T(lang, "sidebar.settings"))
				<li><div class="sidebar-divider"></div></li>
				@sidebarExternalLink("/doctor/sync", "syncHealth", activeNav, T(lang, "sidebar.syncHealth"))
				@sidebarExternalLink("/doctor/orphans", "orphans", activeNav, "Orphans")
				<li><div class="sidebar-divider"></div></li>
				@sidebarLink("/cc-sessions", "cc-sessions", activeNav, T(lang, "sidebar.ccSessions"))
			</ul>
		</nav>
		<!-- health-poll placeholder (deferred to Phase 3) -->
	</aside>
}

// sidebarLink renders an internal navigation link.
templ sidebarLink(href, key, activeNav, label string) {
	<li>
		if key == activeNav {
			<a href={ templ.SafeURL(href) } class="active">{ label }</a>
		} else {
			<a href={ templ.SafeURL(href) }>{ label }</a>
		}
	</li>
}

// sidebarExternalLink renders an external navigation link (full-page nav).
templ sidebarExternalLink(href, key, activeNav, label string) {
	<li>
		if key == activeNav {
			<a href={ templ.SafeURL(href) } class="active">{ label }</a>
		} else {
			<a href={ templ.SafeURL(href) }>{ label }</a>
		}
	</li>
}
