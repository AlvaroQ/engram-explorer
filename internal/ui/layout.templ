package ui

import (
	"context"

	"github.com/AlvaroQ/engram-explorer/internal/providers"
)

// Layout renders the full HTML shell with sidebar navigation and a padded main content area.
// activeNav should match one of the nav item keys (e.g. "topics", "observations").
templ Layout(title, activeNav, lang, theme string, content templ.Component) {
	<!DOCTYPE html>
	<html class={ theme } data-theme={ theme } lang={ lang }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — Engram</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="stylesheet" href="/static/styles.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<!-- Island loader: mounts React components declared with data-island.
			     Only fetches island bundles when [data-island] elements are present. -->
			<script type="module" src="/islands/loader.js"></script>
		</head>
		<body>
			<div class="app-shell">
				@Sidebar(activeNav, lang)
				<main class="main-content">
					@content
				</main>
			</div>
		</body>
	</html>
}

// LayoutFullBleed renders the full HTML shell with sidebar navigation but WITHOUT
// padding on the main content area. Used for pages that need edge-to-edge content
// (e.g. the brain 3D canvas).
templ LayoutFullBleed(title, activeNav, lang, theme string, content templ.Component) {
	<!DOCTYPE html>
	<html class={ theme } data-theme={ theme } lang={ lang }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — Engram</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<link rel="stylesheet" href="/static/styles.css"/>
			<script src="/static/htmx.min.js" defer></script>
			<script type="module" src="/islands/loader.js"></script>
		</head>
		<body>
			<div class="app-shell">
				@Sidebar(activeNav, lang)
				<main class="main-content-full">
					@content
				</main>
			</div>
		</body>
	</html>
}

// Sidebar renders the primary navigation sidebar.
// activeNav is compared against each item's key to mark the active link.
// When NavGroups are present in ctx (injected by renderDeps via NavContextWithGroups),
// the sidebar is data-driven from the registry NavGroups; otherwise it falls back
// to the legacy hardcoded two-section layout (engram + cc-sessions).
templ Sidebar(activeNav, lang string) {
	<aside class="sidebar">
		<div class="sidebar-brand">
			<div class="sidebar-brand-text">
				<h1 class="sidebar-brand-title">{ T(lang, "sidebar.brand") }</h1>
				<p class="sidebar-brand-label">{ T(lang, "sidebar.subtitle") }</p>
			</div>
			@sidebarSettingsIcon(activeNav, T(lang, "sidebar.settings"))
		</div>
		<nav class="sidebar-nav-wrap" aria-label={ T(lang, "sidebar.primaryNav") }>
			if groups := navGroupsFromContext(ctx); len(groups) > 0 {
				// Data-driven path: registry provided NavGroups (WU-7+).
				for i, group := range groups {
					if navShowGroup(ctx, group.ID) {
						@sidebarGroup(T(lang, group.LabelKey), group.ID)
						<ul class="sidebar-nav">
							for _, link := range group.Links {
								if link.External {
									@sidebarExternalLink(link.Href, link.Key, activeNav, T(lang, link.LabelKey))
								} else {
									@sidebarLink(link.Href, link.Key, activeNav, T(lang, link.LabelKey))
								}
							}
						</ul>
					}
					if i < len(groups)-1 {
						@sidebarDividerIfBothVisible(ctx, groups, i, lang)
					}
				}
			} else {
				// Legacy fallback: hardcoded two-section layout when no NavGroups
				// are provided (e.g. existing tests, legacy container path).
				if navShowEngram(ctx) {
					@sidebarGroup(T(lang, "sidebar.groupEngram"), "engram")
					<ul class="sidebar-nav">
						@sidebarLink("/", "overview", activeNav, T(lang, "sidebar.overview"))
						@sidebarLink("/brain", "brain", activeNav, T(lang, "sidebar.knowledge"))
						@sidebarLink("/observations", "observations", activeNav, T(lang, "sidebar.observations"))
						@sidebarLink("/sessions", "sessions", activeNav, T(lang, "sidebar.sessions"))
						@sidebarLink("/projects", "projects", activeNav, T(lang, "sidebar.projects"))
						@sidebarLink("/prompts", "prompts", activeNav, T(lang, "sidebar.prompts"))
						@sidebarLink("/topics", "topics", activeNav, T(lang, "sidebar.topics"))
						@sidebarExternalLink("/doctor/sync", "syncHealth", activeNav, T(lang, "sidebar.syncHealth"))
						@sidebarExternalLink("/doctor/orphans", "orphans", activeNav, "Orphans")
					</ul>
				}
				if navShowEngram(ctx) && navShowClaude(ctx) {
					<div class="sidebar-divider"></div>
				}
				if navShowClaude(ctx) {
					@sidebarGroup(T(lang, "sidebar.groupClaudeCode"), "claude")
					<ul class="sidebar-nav">
						@sidebarLink("/cc-overview", "cc-overview", activeNav, T(lang, "sidebar.ccOverview"))
						@sidebarLink("/cc-sessions", "cc-sessions", activeNav, T(lang, "sidebar.ccSessions"))
					</ul>
				}
			}
		</nav>
	</aside>
}

// sidebarDividerIfBothVisible renders a divider between two sidebar groups
// only when both the current and next group are visible (cookie-check).
templ sidebarDividerIfBothVisible(ctx context.Context, groups []providers.NavGroup, idx int, lang string) {
	if navShowGroup(ctx, groups[idx].ID) && navShowGroup(ctx, groups[idx+1].ID) {
		<div class="sidebar-divider"></div>
	}
}

// sidebarGroup renders a section heading that introduces a group of nav links.
// variant ("engram", "claude", or provider ID) selects the accent color CSS class.
templ sidebarGroup(label, variant string) {
	<p class={ "sidebar-group-label sidebar-group-" + variant }>
		<span class="sidebar-group-dot" aria-hidden="true"></span>
		<span>{ label }</span>
	</p>
}

// sidebarSettingsIcon renders the settings gear in the brand header.
// It is marked active when the settings page is open.
templ sidebarSettingsIcon(activeNav, label string) {
	<a
		href="/settings"
		class={ "sidebar-brand-settings", templ.KV("active", activeNav == "settings") }
		aria-label={ label }
		title={ label }
	>
		<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="12" cy="12" r="3"></circle>
			<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
		</svg>
	</a>
}

// sidebarLink renders an internal navigation link.
templ sidebarLink(href, key, activeNav, label string) {
	<li>
		if key == activeNav {
			<a href={ templ.SafeURL(href) } class="active">{ label }</a>
		} else {
			<a href={ templ.SafeURL(href) }>{ label }</a>
		}
	</li>
}

// sidebarExternalLink renders an external navigation link (full-page nav).
templ sidebarExternalLink(href, key, activeNav, label string) {
	<li>
		if key == activeNav {
			<a href={ templ.SafeURL(href) } class="active">{ label }</a>
		} else {
			<a href={ templ.SafeURL(href) }>{ label }</a>
		}
	</li>
}
