package ui

import (
	"fmt"
	"net/url"
	"time"

	"github.com/AlvaroQ/engram-explorer/internal/services"
)

// memoryTabBar renders the three-tab navigation for the Memory page.
// activeView is "", "threads", or "conversations".
templ memoryTabBar(activeView string, lang string) {
	<nav class="flex gap-1 border-b border-border mb-4" aria-label="Memory tabs">
		<a
			href="/observations"
			class={ "px-4 py-2 text-sm font-medium rounded-t-md border border-transparent -mb-px", templ.KV("border-border border-b-bg text-fg bg-surface", activeView == ""), templ.KV("text-fg-muted hover:text-fg", activeView != "") }
			if activeView == "" {
				aria-current="page"
			}
		>{ T(lang, "memory.tabs.memories") }</a>
		<a
			href="/observations?view=threads"
			class={ "px-4 py-2 text-sm font-medium rounded-t-md border border-transparent -mb-px", templ.KV("border-border border-b-bg text-fg bg-surface", activeView == "threads"), templ.KV("text-fg-muted hover:text-fg", activeView != "threads") }
			if activeView == "threads" {
				aria-current="page"
			}
		>{ T(lang, "memory.tabs.threads") }</a>
		<a
			href="/observations?view=conversations"
			class={ "px-4 py-2 text-sm font-medium rounded-t-md border border-transparent -mb-px", templ.KV("border-border border-b-bg text-fg bg-surface", activeView == "conversations"), templ.KV("text-fg-muted hover:text-fg", activeView != "conversations") }
			if activeView == "conversations" {
				aria-current="page"
			}
		>{ T(lang, "memory.tabs.conversations") }</a>
	</nav>
}

// ObservationsPage renders the full page shell for the observations view.
templ ObservationsPage(items []services.ObservationRow, nextCursor *string, params services.ObservationListParams, projects []string, lang, theme, sidebarState string, advanced bool) {
	@Layout(T(lang, "observations.title"), "observations", lang, theme, sidebarState, observationsContent(items, nextCursor, params, projects, lang, advanced))
}

// ObservationsPartial renders only the observations content (no HTML shell).
// Used when HTMX requests a partial update.
templ ObservationsPartial(items []services.ObservationRow, nextCursor *string, params services.ObservationListParams, projects []string, lang string, advanced bool) {
	@observationsContent(items, nextCursor, params, projects, lang, advanced)
}

// MemoryThreadsPage renders the full Memory page shell with the Threads tab active.
templ MemoryThreadsPage(topics []services.TopicRow, query, lang, theme, sidebarState string) {
	@Layout(T(lang, "observations.title"), "observations", lang, theme, sidebarState, memoryThreadsContent(topics, query, lang))
}

// MemoryThreadsPartial renders only the Threads tab content (no HTML shell).
templ MemoryThreadsPartial(topics []services.TopicRow, query, lang string) {
	@memoryThreadsContent(topics, query, lang)
}

// memoryThreadsContent wraps the tab bar + TopicsPartial content for the Threads view.
templ memoryThreadsContent(topics []services.TopicRow, query, lang string) {
	<div class="flex flex-col gap-4">
		@memoryTabBar("threads", lang)
		@TopicsPartial(topics, query, lang)
	</div>
}

// MemoryConversationsPage renders the full Memory page shell with the Conversations tab active.
templ MemoryConversationsPage(items []services.PromptRow, searchItems []services.PromptWithSnippet, query, lang, theme, sidebarState string) {
	@Layout(T(lang, "observations.title"), "observations", lang, theme, sidebarState, memoryConversationsContent(items, searchItems, query, lang))
}

// MemoryConversationsPartial renders only the Conversations tab content (no HTML shell).
templ MemoryConversationsPartial(items []services.PromptRow, searchItems []services.PromptWithSnippet, query, lang string) {
	@memoryConversationsContent(items, searchItems, query, lang)
}

// memoryConversationsContent wraps the tab bar + PromptsPartial content for the Conversations view.
templ memoryConversationsContent(items []services.PromptRow, searchItems []services.PromptWithSnippet, query, lang string) {
	<div class="flex flex-col gap-4">
		@memoryTabBar("conversations", lang)
		@PromptsPartial(items, searchItems, query, lang)
	</div>
}

// advancedViewToggle renders the Advanced view toggle button for the Memories tab.
// POSTs to /settings/advanced-view; HTMX triggers a full-page redirect to /observations.
templ advancedViewToggle(advanced bool, lang string) {
	<form
		method="POST"
		action="/settings/advanced-view"
		class="flex items-center gap-2"
		hx-post="/settings/advanced-view"
		hx-swap="none"
	>
		<input type="hidden" name="enabled" value={ obsAdvancedNextVal(advanced) }/>
		<button
			type="submit"
			class="flex items-center gap-1.5 cursor-pointer select-none text-xs text-fg-muted bg-transparent border-none p-0 font-inherit"
		>
			<span
				class={ "relative inline-block w-8 h-4 rounded-full transition-colors duration-200", templ.KV("bg-accent", advanced), templ.KV("bg-border", !advanced) }
				aria-hidden="true"
			>
				<span
					class={ "absolute top-0.5 left-0.5 w-3 h-3 rounded-full bg-surface transition-transform duration-200", templ.KV("translate-x-4", advanced) }
				></span>
			</span>
			{ T(lang, "memory.advancedView.label") }
		</button>
	</form>
}

// observationsContent is the shared observations body.
templ observationsContent(items []services.ObservationRow, nextCursor *string, params services.ObservationListParams, projects []string, lang string, advanced bool) {
	<div class="flex flex-col gap-4">
		@memoryTabBar("", lang)
		<div class="page-header flex items-start justify-between gap-4">
			<div>
				<h1>{ T(lang, "observations.title") }</h1>
				<p>{ T(lang, "observations.description") }</p>
			</div>
			@advancedViewToggle(advanced, lang)
		</div>
		<!-- Filter bar -->
		<div class="card filter-bar" id="obs-filter-bar">
			<div class="card-body">
				<!-- Text search -->
				<div class="filter-row">
					<input
						id="obs-q"
						class="input flex-1"
						type="search"
						name="q"
						value={ params.Q }
						placeholder={ T(lang, "observations.searchPlaceholder") }
						hx-get="/observations/list"
						hx-trigger="keyup changed delay:300ms, search"
						hx-target="#obs-table-container"
						hx-include="#obs-filters"
						hx-push-url="true"
					/>
				</div>
				<!-- Additional filters (collapsed by default) -->
				<details class="obs-filters-disclosure">
					<summary class="obs-filters-summary">
						{ T(lang, "observations.filters.toggle") }
						if obsActiveFilterCount(params) > 0 {
							<span class="obs-filters-badge">{ fmt.Sprintf("%d", obsActiveFilterCount(params)) }</span>
						}
					</summary>
					<form
						id="obs-filters"
						hx-get="/observations/list"
						hx-trigger="change"
						hx-target="#obs-table-container"
						hx-include="#obs-q"
						hx-push-url="true"
						class="obs-filters-body"
					>
						<!-- Project multi-select (disclosure dropdown) -->
						<div class="flex flex-col gap-1">
							<label class="filter-label">{ T(lang, "observations.labels.project") }</label>
							<details class="obs-filter-dropdown">
								<summary class="obs-filter-dropdown-summary">
									if len(params.Projects) > 0 {
										{ fmt.Sprintf("(%d)", len(params.Projects)) }
									}
								</summary>
								<div class="obs-filter-dropdown-body input overflow-y-auto" style="max-height:120px">
									for _, p := range projects {
										<label class="flex items-center gap-2 py-0.5 text-xs">
											<input type="checkbox" name="project" value={ p } checked?={ obsContains(params.Projects, p) }/>
											{ p }
										</label>
									}
								</div>
							</details>
						</div>
						<!-- Type multi-select (disclosure dropdown) -->
						<div class="flex flex-col gap-1">
							<label class="filter-label">{ T(lang, "observations.labels.type") }</label>
							<details class="obs-filter-dropdown">
								<summary class="obs-filter-dropdown-summary">
									if len(params.Types) > 0 {
										{ fmt.Sprintf("(%d)", len(params.Types)) }
									}
								</summary>
								<div class="obs-filter-dropdown-body input overflow-y-auto" style="max-height:120px">
									for _, typ := range obsTypeOptions() {
										<label class="flex items-center gap-2 py-0.5 text-xs">
											<input type="checkbox" name="type" value={ typ } checked?={ obsContains(params.Types, typ) }/>
											{ typ }
										</label>
									}
								</div>
							</details>
						</div>
						<!-- Scope select -->
						<div class="flex flex-col gap-1">
							<label class="filter-label" for="obs-scope">{ T(lang, "observations.labels.scope") }</label>
							<select id="obs-scope" name="scope" class="input input-sm">
								<option value="" selected?={ params.Scope == "" || params.Scope == "all" }>{ T(lang, "observations.scope.all") }</option>
								<option value="project" selected?={ params.Scope == "project" }>{ T(lang, "observations.scope.project") }</option>
								<option value="personal" selected?={ params.Scope == "personal" }>{ T(lang, "observations.scope.personal") }</option>
							</select>
						</div>
						<!-- Topic key input -->
						<div class="flex flex-col gap-1">
							<label class="filter-label" for="obs-topic">{ T(lang, "observations.labels.topicKey") }</label>
							<input id="obs-topic" class="input input-sm" type="text" name="topic_key" value={ params.TopicKey } placeholder={ T(lang, "observations.placeholders.topicKey") }/>
						</div>
						<!-- Deleted rows select -->
						<div class="flex flex-col gap-1">
							<label class="filter-label" for="obs-deleted">{ T(lang, "observations.labels.deletedRows") }</label>
							<select id="obs-deleted" name="deleted" class="input input-sm">
								<option value="active" selected?={ !params.IncludeDeleted && !params.OnlyDeleted }>{ T(lang, "observations.deleted.active") }</option>
								<option value="all" selected?={ params.IncludeDeleted }>{ T(lang, "observations.deleted.all") }</option>
								<option value="only" selected?={ params.OnlyDeleted }>{ T(lang, "observations.deleted.only") }</option>
							</select>
						</div>
					</form>
				</details>
			</div>
		</div>
		<!-- Table + detail layout -->
		<div class="flex gap-4" style="min-height:0; flex:1">
			<!-- Table card -->
			<div class="card flex-1 overflow-hidden">
				<div class="card-header">
					<h2>{ T(lang, "observations.title") }</h2>
					<p>{ T(lang, "observations.loaded", "count", fmt.Sprintf("%d", len(items))) }</p>
				</div>
				<div class="card-body p-0 overflow-auto" id="obs-table-container">
					@ObservationsTablePartial(items, nextCursor, params, lang, advanced)
				</div>
			</div>
			<!-- Detail aside (empty until a row is clicked) -->
			<aside id="obs-detail" class="card" style="width:380px;min-width:280px;overflow-y:auto;display:none">
				<!-- Populated by hx-get /observations/{id} on row click -->
			</aside>
		</div>
	</div>
	<!-- Show the detail aside when HTMX swaps content into it. -->
	<script>
	document.body.addEventListener('htmx:afterSwap', function(e) {
		if (e.target && e.target.id === 'obs-detail') {
			e.target.style.display = '';
		}
	});
	</script>
}

// ObservationsTablePartial renders the full table with load-more.
// This is the HTMX swap target for filter changes (replaces whole table content).
// advanced gates the technical columns (Rev, Dup, Sync id).
templ ObservationsTablePartial(items []services.ObservationRow, nextCursor *string, params services.ObservationListParams, lang string, advanced bool) {
	if len(items) == 0 {
		@EmptyState(T(lang, "observations.table.noMatch"))
	} else {
		<table class="data-table" id="obs-table">
			<thead>
				<tr>
					<th>{ T(lang, "observations.table.created") }</th>
					<th>{ T(lang, "observations.table.title") }</th>
					<th>{ T(lang, "observations.table.topic") }</th>
					<th>{ T(lang, "observations.table.project") }</th>
					<th>{ T(lang, "observations.table.type") }</th>
					if advanced {
						<th>{ T(lang, "observations.table.rev") }</th>
						<th>{ T(lang, "observations.table.dup") }</th>
					}
				</tr>
			</thead>
			<tbody id="obs-tbody">
				@ObservationsRowsPartial(items, nextCursor, params, lang, advanced)
			</tbody>
		</table>
	}
}

// ObservationsRowsPartial renders only <tr> rows + optional load-more sentinel.
// Used by hx-swap="beforeend" on load-more.
// advanced gates the technical columns (Rev, Dup, Sync id) in each row.
templ ObservationsRowsPartial(items []services.ObservationRow, nextCursor *string, params services.ObservationListParams, lang string, advanced bool) {
	for _, obs := range items {
		@obsRow(obs, lang, advanced)
	}
	if nextCursor != nil {
		@obsLoadMoreRow(*nextCursor, params, lang, advanced)
	}
}

// dateClockCell renders a timestamp as two stacked lines: dd-mm-yyyy on top,
// hh:mm below. Shared by the Memory table and the Overview recent list.
templ dateClockCell(raw string) {
	{{ d, c := splitDateClock(raw) }}
	<div class="inline-block">
		<div>{ d }</div>
		if c != "" {
			<div class="muted text-center">{ c }</div>
		}
	</div>
}

// obsRow renders a single observation table row.
// advanced gates the technical columns: Rev, Dup (sync_id is detail-only).
templ obsRow(obs services.ObservationRow, lang string, advanced bool) {
	<tr
		data-obs-id={ fmt.Sprintf("%d", obs.ID) }
		class="hover:bg-surface-2 cursor-pointer"
		hx-get={ fmt.Sprintf("/observations/%d", obs.ID) }
		hx-target="#obs-detail"
		hx-swap="innerHTML"
	>
		<td class="mono text-xs text-fg-muted whitespace-nowrap">
			@dateClockCell(obsDateRaw(obs))
		</td>
		<td class="text-sm text-fg truncate" style="max-width:320px">
			if obs.ReviewDue() {
				<span class="badge badge-warn mr-1">{ T(lang, "observations.badge.reviewDue") }</span>
			}
			if obs.Title != nil && *obs.Title != "" {
				{ *obs.Title }
			} else {
				<span class="muted">{ T(lang, "common.untitled") }</span>
			}
		</td>
		<td class="mono text-xs text-fg-muted truncate" style="max-width:160px">
			if obs.TopicKey != nil && *obs.TopicKey != "" {
				{ *obs.TopicKey }
			} else {
				{ "—" }
			}
		</td>
		<td>
			if obs.Project != nil && *obs.Project != "" {
				<span class="badge badge-neutral">{ *obs.Project }</span>
			} else {
				<span class="badge badge-fail">{ T(lang, "observations.table.empty") }</span>
			}
		</td>
		<td><span class="badge badge-neutral">{ obs.Type }</span></td>
		if advanced {
			<td class="text-xs text-fg-muted">{ fmt.Sprintf("%d", obsRevCount(obs)) }</td>
			<td class="text-xs text-fg-muted">{ fmt.Sprintf("%d", obsDupCount(obs)) }</td>
		}
	</tr>
}

// obsLoadMoreRow renders the load-more sentinel row for cursor pagination.
// colspan matches the visible column count: 5 base columns + 2 when advanced.
//
// The button replaces its OWN row (outerHTML on the closest <tr>) with the next
// page — which is itself "new rows + a fresh sentinel". This keeps exactly one
// sentinel at the end of the list. The earlier approach appended (beforeend) and
// then tried to delete the old sentinel by id, but the appended page carried a
// new row with the same id, so getElementById could leave a stale sentinel
// stranded in the middle of the table.
templ obsLoadMoreRow(cursor string, params services.ObservationListParams, lang string, advanced bool) {
	<tr id="obs-load-more-row">
		<td colspan={ obsColspan(advanced) } class="px-4 py-3">
			<button
				class="btn btn-secondary btn-sm"
				hx-get={ obsNextURL(cursor, params, advanced) }
				hx-target="closest tr"
				hx-swap="outerHTML"
			>
				{ T(lang, "common.loadMore") }
			</button>
		</td>
	</tr>
}

// ObservationDetailPartial renders the observation detail for the aside drawer.
templ ObservationDetailPartial(obs *services.ObservationRow, revisions []services.ObservationRow, heading, lang string) {
	<div class="space-y-4 text-sm p-3">
		<div class="flex items-center justify-between gap-2">
			<h2 class="text-base font-semibold text-fg">{ heading }</h2>
			<button
				type="button"
				class="btn btn-ghost btn-sm"
				onclick="document.getElementById('obs-detail').style.display='none'"
				aria-label={ T(lang, "common.close") }
			>×</button>
		</div>
		<!-- Badges row -->
		<div class="flex flex-wrap gap-2">
			<span class="badge badge-accent">{ obs.Type }</span>
			if obs.ReviewDue() {
				<span class="badge badge-warn">{ T(lang, "observations.badge.reviewDue") }</span>
			}
			if obs.Scope != nil && *obs.Scope != "" {
				<span class="badge badge-neutral">{ T(lang, "observations.detail.scope", "scope", *obs.Scope) }</span>
			}
			if obs.ToolName != nil && *obs.ToolName != "" {
				<span class="badge badge-neutral">{ *obs.ToolName }</span>
			}
			if obs.DeletedAt != nil {
				<span class="badge badge-fail">{ T(lang, "observations.detail.deleted") }</span>
			}
		</div>
		<!-- Title -->
		<h3 class="text-base font-semibold text-fg">
			if obs.Title != nil && *obs.Title != "" {
				{ *obs.Title }
			} else {
				{ T(lang, "common.untitled") }
			}
		</h3>
		<!-- Field grid -->
		<dl class="grid grid-cols-1 gap-x-4 gap-y-1 text-xs sm:grid-cols-2">
			@obsDetailField(T(lang, "observations.detail.fields.project"), nilStr(obs.Project), false)
			@obsDetailField(T(lang, "observations.detail.fields.topicKey"), nilStr(obs.TopicKey), true)
			@obsDetailField(T(lang, "observations.detail.fields.created"), nilStr(obs.CreatedAt), false)
			@obsDetailField(T(lang, "observations.detail.fields.updated"), nilStr(obs.UpdatedAt), false)
			@obsDetailField(T(lang, "observations.detail.fields.revisions"), fmt.Sprintf("%d", obsRevCount(*obs)), false)
			@obsDetailField(T(lang, "observations.detail.fields.duplicates"), fmt.Sprintf("%d", obsDupCount(*obs)), false)
			@obsDetailField(T(lang, "observations.detail.fields.session"), nilStr(obs.SessionID), true)
			@obsDetailField(T(lang, "observations.detail.fields.syncId"), nilStr(obs.SyncID), true)
			if obs.DeletedAt != nil {
				@obsDetailField(T(lang, "observations.detail.fields.deletedAt"), nilStr(obs.DeletedAt), false)
			}
		</dl>
		<!-- Content -->
		<div>
			<h4 class="mb-2 text-xs uppercase tracking-wide text-fg-muted">{ T(lang, "observations.detail.content") }</h4>
			<pre class="max-h-96 overflow-auto whitespace-pre-wrap rounded-md border border-border bg-surface-2 p-3 text-xs text-fg">
				if obs.Content != nil && *obs.Content != "" {
					{ *obs.Content }
				} else {
					{ T(lang, "common.empty") }
				}
			</pre>
		</div>
		<!-- Revisions -->
		if len(revisions) > 0 {
			<div>
				<h4 class="mb-2 text-xs uppercase tracking-wide text-fg-muted">
					{ T(lang, "observations.detail.revisions", "count", fmt.Sprintf("%d", len(revisions))) }
				</h4>
				<ul class="divide-y divide-border rounded-md border border-border bg-surface-2">
					for _, rev := range revisions {
						<li class="flex items-center justify-between gap-3 p-2 text-xs">
							<div class="min-w-0">
								<p class="truncate text-fg">
									if rev.Title != nil && *rev.Title != "" {
										{ *rev.Title }
									} else {
										{ T(lang, "common.untitled") }
									}
								</p>
								<p class="text-fg-muted">
									if rev.UpdatedAt != nil {
										{ *rev.UpdatedAt }
									} else if rev.CreatedAt != nil {
										{ *rev.CreatedAt }
									} else {
										{ "—" }
									}
								</p>
							</div>
							<span class="badge badge-neutral">{ rev.Type }</span>
						</li>
					}
				</ul>
			</div>
		}
		<!-- Go to session link -->
		if obs.SessionID != nil && *obs.SessionID != "" {
			<a
				href={ templ.SafeURL("/sessions/" + *obs.SessionID) }
				class="inline-flex items-center gap-1 rounded-md border border-border bg-surface-2 px-2 py-1 text-xs text-fg-muted hover:text-fg"
			>
				{ T(lang, "observations.detail.goToSession") }
			</a>
		}
	</div>
}

// obsDetailField renders a single label+value pair in the field grid.
templ obsDetailField(label, value string, mono bool) {
	<div class="flex min-w-0 flex-col gap-0.5">
		<dt class="text-fg-muted">{ label }</dt>
		if mono {
			<dd class="truncate font-mono text-fg">{ value }</dd>
		} else {
			<dd class="truncate text-fg">{ value }</dd>
		}
	</div>
}

// ---------------------------------------------------------------------------
// Helper functions
// ---------------------------------------------------------------------------

// obsTypeOptions returns the static list of known observation types.
func obsTypeOptions() []string {
	return []string{
		"architecture", "bugfix", "decision", "discovery", "session_summary",
		"config", "ui-fix", "pattern", "preference", "insight", "project",
		"learning", "manual", "feature", "command",
	}
}

// obsContains reports whether slice contains target.
func obsContains(slice []string, target string) bool {
	for _, s := range slice {
		if s == target {
			return true
		}
	}
	return false
}

const sqliteTimeLayout = "2006-01-02 15:04:05"

// obsDateStr returns the date portion of an observation's timestamp as dd-mm-yyyy.
// Falls back to first 10 chars or raw value if parsing fails.
func obsDateStr(obs services.ObservationRow) string {
	d, _ := splitDateClock(obsDateRaw(obs))
	return d
}

// obsDateRaw returns the raw timestamp used for the Created column: the
// updated_at value when present, otherwise created_at.
func obsDateRaw(obs services.ObservationRow) string {
	if obs.UpdatedAt != nil && *obs.UpdatedAt != "" {
		return *obs.UpdatedAt
	}
	if obs.CreatedAt != nil && *obs.CreatedAt != "" {
		return *obs.CreatedAt
	}
	return ""
}

// splitDateClock parses a SQLite timestamp into a dd-mm-yyyy date and an hh:mm
// clock. On parse failure it returns best-effort fallbacks (clock may be empty).
func splitDateClock(raw string) (date, clock string) {
	if raw == "" {
		return "—", ""
	}
	t, err := time.Parse(sqliteTimeLayout, raw)
	if err != nil {
		if len(raw) >= 10 {
			date = raw[:10]
		} else {
			date = raw
		}
		if len(raw) >= 16 {
			clock = raw[11:16]
		}
		return date, clock
	}
	return fmt.Sprintf("%02d-%02d-%04d", t.Day(), t.Month(), t.Year()),
		fmt.Sprintf("%02d:%02d", t.Hour(), t.Minute())
}

// obsRevCount returns the revision count (0 when nil).
func obsRevCount(obs services.ObservationRow) int64 {
	if obs.RevisionCount != nil {
		return *obs.RevisionCount
	}
	return 0
}

// obsDupCount returns the duplicate count (0 when nil).
func obsDupCount(obs services.ObservationRow) int64 {
	if obs.DuplicateCount != nil {
		return *obs.DuplicateCount
	}
	return 0
}

// obsColspan returns the colspan value for the load-more sentinel row.
// 5 base columns (date, project, type, title, topic) + 2 when advanced (rev, dup).
func obsColspan(advanced bool) string {
	if advanced {
		return "7"
	}
	return "5"
}

// obsActiveFilterCount returns how many filter groups have at least one value set.
func obsActiveFilterCount(params services.ObservationListParams) int {
	count := 0
	if len(params.Projects) > 0 {
		count++
	}
	if len(params.Types) > 0 {
		count++
	}
	if params.Scope != "" && params.Scope != "all" {
		count++
	}
	if params.TopicKey != "" {
		count++
	}
	if params.IncludeDeleted || params.OnlyDeleted {
		count++
	}
	return count
}

// obsAdvancedNextVal returns the value for the hidden "enabled" input in the toggle form.
// The toggle sends the NEXT (flipped) value so a single submit flips the preference.
func obsAdvancedNextVal(advanced bool) string {
	if advanced {
		return "false"
	}
	return "true"
}

// obsNextURL builds the load-more URL preserving all active filters + new cursor.
// The advanced flag is encoded so appended rows render the SAME column set as the
// already-rendered header, even if the per-profile preference changes mid-page.
func obsNextURL(cursor string, params services.ObservationListParams, advanced bool) string {
	v := url.Values{}
	v.Set("cursor", cursor)
	v.Set("append", "true")
	if advanced {
		v.Set("advanced", "true")
	}
	if params.Q != "" {
		v.Set("q", params.Q)
	}
	for _, p := range params.Projects {
		v.Add("project", p)
	}
	for _, t := range params.Types {
		v.Add("type", t)
	}
	for _, tn := range params.ToolNames {
		v.Add("tool_name", tn)
	}
	if params.Scope != "" && params.Scope != "all" {
		v.Set("scope", params.Scope)
	}
	if params.TopicKey != "" {
		v.Set("topic_key", params.TopicKey)
	}
	if params.IncludeDeleted {
		v.Set("deleted", "all")
	} else if params.OnlyDeleted {
		v.Set("deleted", "only")
	}
	return "/observations/list?" + v.Encode()
}

