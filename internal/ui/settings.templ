package ui

// accountsPage.templ is co-located here because the accounts page shares the
// same settings layout shell and view-model infrastructure.

// AccountsPage renders the full accounts management page (layout shell + content).
templ AccountsPage(d accountsData) {
	@Layout(T(d.Lang, "settings.accounts.title"), "settings", d.Lang, d.Theme, d.SidebarState, accountsContent(d))
}

// AccountsPartial renders only the accounts content (no HTML shell).
// Used when HTMX requests a partial update.
templ AccountsPartial(d accountsData) {
	@accountsContent(d)
}

// accountsContent renders the accounts management body: profile list, create form.
templ accountsContent(d accountsData) {
	<div class="settings-page" id="settings-accounts">
		<div class="page-header">
			<h1>{ T(d.Lang, "settings.accounts.title") }</h1>
		</div>
		if d.AccountsError != "" {
			<div class="settings-group">
				<p class="error-hint">{ d.AccountsError }</p>
			</div>
		}
		<section class="settings-group">
			<h2 class="settings-group-title">{ T(d.Lang, "settings.accounts.profilesTitle") }</h2>
			<p class="settings-group-desc">{ T(d.Lang, "settings.accounts.profilesDesc") }</p>
			if len(d.Profiles) > 0 {
				<div class="modules-list">
					for _, p := range d.Profiles {
						@profileRow(d.Lang, p)
					}
				</div>
			} else {
				<p class="preference-desc">{ T(d.Lang, "settings.accounts.noProfiles") }</p>
			}
		</section>
		<section class="settings-group">
			<h2 class="settings-group-title">{ T(d.Lang, "settings.accounts.createTitle") }</h2>
			<form class="path-edit-form" method="post" action="/settings/profile/create"
				hx-post="/settings/profile/create"
				hx-target="#settings-accounts"
				hx-swap="outerHTML">
				<input
					type="text"
					name="name"
					class="path-input"
					autocomplete="off"
					autocapitalize="off"
					spellcheck="false"
					aria-label={ T(d.Lang, "settings.accounts.namePlaceholder") }
					placeholder={ T(d.Lang, "settings.accounts.namePlaceholder") }
				/>
				<button type="submit" class="btn btn-sm btn-primary">
					{ T(d.Lang, "settings.accounts.create") }
				</button>
			</form>
		</section>
	</div>
}

// profileRow renders one profile row in the Settings → Accounts section.
templ profileRow(lang string, p ProfileInfo) {
	<div class="module-row">
		<div class="module-row-header">
			<div class="module-row-identity">
				<span class="module-name">{ p.Name }</span>
				if p.Active {
					<span class="badge badge-ok">{ T(lang, "settings.accounts.active") }</span>
				}
			</div>
			<div class="module-row-toggle">
				if !p.Active {
					<form method="post" action="/settings/profile/switch"
						hx-post="/settings/profile/switch"
						hx-target="#settings-accounts"
						hx-swap="outerHTML">
						<input type="hidden" name="name" value={ p.Name }/>
						<button type="submit" class="btn btn-sm btn-primary">
							{ T(lang, "settings.accounts.switch") }
						</button>
					</form>
					<form method="post" action="/settings/profile/delete"
						hx-post="/settings/profile/delete"
						hx-target="#settings-accounts"
						hx-swap="outerHTML">
						<input type="hidden" name="name" value={ p.Name }/>
						<button type="submit" class="btn btn-sm btn-secondary">
							{ T(lang, "settings.accounts.delete") }
						</button>
					</form>
				}
			</div>
		</div>
	</div>
}

// settingsData carries all data needed to render the settings page.
type settingsData struct {
	DBPath          string
	DBOk            bool
	EngramPathError string
	ClaudePath      string
	ClaudeOk        bool
	ClaudePathError string
	DaemonURL       string
	DaemonOk        bool
	DaemonError     string
	// ShowNavGroups maps provider ID to visibility (true=shown).
	// Keys: "engram", "cc-sessions". Replaces the old ShowEngram/ShowClaude booleans.
	ShowNavGroups map[string]bool
	UptimeS       int
	Lang          string
	Theme         string
	SidebarState  string

	// WU-8: Modules section data.
	// Modules is the list of registered providers for the Settings → Modules page.
	// Nil when the registry is not wired (legacy mode or nil Deps.Modules).
	Modules []ModuleInfo
	// ModuleError is a generic error from a toggle or path operation.
	ModuleError string
	// ModulePathErrors maps provider ID to a path-validation error message.
	ModulePathErrors map[string]string

	// Slice 2b: Claude Code accounts section.
	// CCAccounts is the list of all CC accounts (enabled+disabled) for the
	// Settings → Claude Code accounts section. Nil when callbacks are not wired.
	CCAccounts []CCAccountInfo
	// CCAccountError is a generic error from an add / remove / toggle operation.
	CCAccountError string
}

// SettingsPage renders the full settings page shell.
templ SettingsPage(d settingsData) {
	@Layout(T(d.Lang, "settings.title"), "settings", d.Lang, d.Theme, d.SidebarState, settingsContent(d))
}

// SettingsPartial renders only the settings content (no HTML shell).
// Used when HTMX requests a partial update.
templ SettingsPartial(d settingsData) {
	@settingsContent(d)
}

// settingsContent is the shared settings body used by both full-page and partial
// renders. It is a flat list of titled groups (no card chrome) for a clean view.
templ settingsContent(d settingsData) {
	<div class="settings-page">
		<div class="page-header">
			<h1>{ T(d.Lang, "settings.title") }</h1>
		</div>

		<!-- Apariencia -->
		<section class="settings-group">
			<h2 class="settings-group-title">{ T(d.Lang, "settings.section.appearance") }</h2>
			<div class="preference-row">
				<div class="preference-label">
					<p class="preference-name">{ T(d.Lang, "settings.language") }</p>
					<p class="preference-desc">{ T(d.Lang, "settings.languageDescription") }</p>
				</div>
				<div class="preference-controls">
					<form method="post" action="/lang">
						<button
							type="submit"
							name="value"
							value="en"
							class={ "btn btn-sm", templ.KV("btn-primary", d.Lang == "en"), templ.KV("btn-secondary", d.Lang != "en") }
						>
							{ T(d.Lang, "lang.en") }
						</button>
					</form>
					<form method="post" action="/lang">
						<button
							type="submit"
							name="value"
							value="es"
							class={ "btn btn-sm", templ.KV("btn-primary", d.Lang == "es"), templ.KV("btn-secondary", d.Lang != "es") }
						>
							{ T(d.Lang, "lang.es") }
						</button>
					</form>
				</div>
			</div>
			<div class="preference-row">
				<div class="preference-label">
					<p class="preference-name">{ T(d.Lang, "settings.theme") }</p>
				</div>
				<div class="preference-controls">
					<form method="post" action="/theme">
						<button
							type="submit"
							name="value"
							value="dark"
							class={ "btn btn-sm", templ.KV("btn-primary", d.Theme == "dark"), templ.KV("btn-secondary", d.Theme != "dark") }
						>
							{ T(d.Lang, "settings.themeDark") }
						</button>
					</form>
					<form method="post" action="/theme">
						<button
							type="submit"
							name="value"
							value="light"
							class={ "btn btn-sm", templ.KV("btn-primary", d.Theme == "light"), templ.KV("btn-secondary", d.Theme != "light") }
						>
							{ T(d.Lang, "settings.themeLight") }
						</button>
					</form>
				</div>
			</div>
		</section>

		<!-- Secciones del menú -->
		<section class="settings-group">
			<h2 class="settings-group-title">{ T(d.Lang, "settings.navTitle") }</h2>
			<p class="settings-group-desc">{ T(d.Lang, "settings.navHeaderDesc") }</p>
			<div class="preference-row">
				<div class="preference-label">
					<p class="preference-name">{ T(d.Lang, "settings.navEngram") }</p>
					<p class="preference-desc">{ T(d.Lang, "settings.navDescription") }</p>
				</div>
				@navVisibilityControls(d.Lang, "engram", d.ShowNavGroups["engram"])
			</div>
			<div class="preference-row">
				<div class="preference-label">
					<p class="preference-name">{ T(d.Lang, "settings.navClaude") }</p>
				</div>
				@navVisibilityControls(d.Lang, "cc-sessions", d.ShowNavGroups["cc-sessions"])
			</div>
		</section>

		<!-- Sistema (Engram database) -->
		<section class="settings-group">
			<h2 class="settings-group-title">{ T(d.Lang, "settings.section.system") }</h2>
			<p class="settings-group-desc">{ T(d.Lang, "settings.db.description") }</p>
			<div class="info-row">
				<span class="info-label muted">{ T(d.Lang, "settings.row.path") }</span>
				<span class="info-value mono">
					if d.DBPath != "" {
						{ d.DBPath }
					} else {
						{ "—" }
					}
				</span>
			</div>
			<div class="info-row">
				<span class="info-label muted">{ T(d.Lang, "settings.row.status") }</span>
				<span>
					if d.DBOk {
						<span class="badge badge-ok">{ T(d.Lang, "settings.badge.connected") }</span>
					} else {
						<span class="badge badge-fail">{ T(d.Lang, "settings.badge.unavailable") }</span>
					}
				</span>
			</div>
			<form class="path-edit-form" method="post" action="/settings/engram-db">
				<input
					type="text"
					name="path"
					value={ d.DBPath }
					class="path-input mono"
					autocomplete="off"
					autocapitalize="off"
					spellcheck="false"
					aria-label={ T(d.Lang, "settings.db.editLabel") }
				/>
				<button type="submit" class="btn btn-sm btn-primary">{ T(d.Lang, "settings.path.apply") }</button>
			</form>
			<p class="preference-desc">{ T(d.Lang, "settings.db.editHint") }</p>
			if d.EngramPathError != "" {
				<p class="error-hint">{ d.EngramPathError }</p>
			}
			<div class="db-actions">
				<a href="/api/db/export" class="btn btn-sm" download>{ T(d.Lang, "settings.db.export") }</a>
				<form
					method="post"
					action="/api/db/import"
					enctype="multipart/form-data"
					onsubmit="return confirm('Import database? Only new memories are added — nothing is overwritten. A backup is taken first.')"
				>
					<label class="btn btn-sm" style="cursor:pointer;">
						{ T(d.Lang, "settings.db.import") }
						<input type="file" name="file" accept=".db,.sqlite,.sqlite3,application/octet-stream" style="display:none;" onchange="this.form.submit()"/>
					</label>
				</form>
			</div>
		</section>

		<!-- Claude Code -->
		<section class="settings-group">
			<h2 class="settings-group-title">{ T(d.Lang, "settings.claude") }</h2>
			<p class="settings-group-desc">{ T(d.Lang, "settings.claudeDescription") }</p>
			<div class="info-row">
				<span class="info-label muted">{ T(d.Lang, "settings.row.path") }</span>
				<span class="info-value mono">
					if d.ClaudePath != "" {
						{ d.ClaudePath }
					} else {
						{ "—" }
					}
				</span>
			</div>
			<div class="info-row">
				<span class="info-label muted">{ T(d.Lang, "settings.row.status") }</span>
				<span>
					if d.ClaudeOk {
						<span class="badge badge-ok">{ T(d.Lang, "settings.badge.found") }</span>
					} else {
						<span class="badge badge-fail">{ T(d.Lang, "settings.badge.missing") }</span>
					}
				</span>
			</div>
			<form class="path-edit-form" method="post" action="/settings/claude-dir">
				<input
					type="text"
					name="path"
					value={ d.ClaudePath }
					class="path-input mono"
					autocomplete="off"
					autocapitalize="off"
					spellcheck="false"
					aria-label={ T(d.Lang, "settings.claudeEditLabel") }
				/>
				<button type="submit" class="btn btn-sm btn-primary">{ T(d.Lang, "settings.path.apply") }</button>
			</form>
			<p class="preference-desc">{ T(d.Lang, "settings.claudeEditHint") }</p>
			if d.ClaudePathError != "" {
				<p class="error-hint">{ d.ClaudePathError }</p>
			}
		</section>

		<!-- Módulos de proveedores (WU-8) -->
		<!-- Generic module-level error: shown even when Modules list is nil (e.g. path error on page with no registry) -->
		if d.ModuleError != "" {
			<div class="settings-group">
				<p class="error-hint">{ d.ModuleError }</p>
			</div>
		}
		<!-- Modules section: shown only when registry is wired and has providers -->
		if len(d.Modules) > 0 {
			<section class="settings-group" id="settings-modules">
				<h2 class="settings-group-title">{ T(d.Lang, "settings.modules.title") }</h2>
				<p class="settings-group-desc">{ T(d.Lang, "settings.modules.description") }</p>
				<div class="modules-list">
					for _, m := range d.Modules {
						@moduleRow(d.Lang, m, d.ModulePathErrors[m.ID])
					}
				</div>
			</section>
		}

		<!-- Claude Code accounts (Slice 2b) -->
		if d.CCAccountError != "" {
			<div class="settings-group">
				<p class="error-hint">{ d.CCAccountError }</p>
			</div>
		}
		if d.CCAccounts != nil {
			<section class="settings-group" id="settings-cc-accounts">
				<h2 class="settings-group-title">{ T(d.Lang, "settings.ccAccounts.title") }</h2>
				<p class="settings-group-desc">{ T(d.Lang, "settings.ccAccounts.description") }</p>
				if len(d.CCAccounts) > 0 {
					<div class="modules-list">
						for _, acc := range d.CCAccounts {
							@ccAccountRow(d.Lang, acc, len(d.CCAccounts) == 1)
						}
					</div>
				}
				<section class="settings-group">
					<h2 class="settings-group-title">{ T(d.Lang, "settings.ccAccounts.addTitle") }</h2>
					<form class="path-edit-form" method="post" action="/settings/cc-accounts"
						hx-post="/settings/cc-accounts"
						hx-target="#settings-cc-accounts"
						hx-swap="outerHTML">
						<input
							type="text"
							name="label"
							class="path-input"
							autocomplete="off"
							autocapitalize="off"
							spellcheck="false"
							aria-label={ T(d.Lang, "settings.ccAccounts.labelPlaceholder") }
							placeholder={ T(d.Lang, "settings.ccAccounts.labelPlaceholder") }
						/>
						<input
							type="text"
							name="path"
							class="path-input mono"
							autocomplete="off"
							autocapitalize="off"
							spellcheck="false"
							aria-label={ T(d.Lang, "settings.ccAccounts.pathPlaceholder") }
							placeholder={ T(d.Lang, "settings.ccAccounts.pathPlaceholder") }
						/>
						<button type="submit" class="btn btn-sm btn-primary">
							{ T(d.Lang, "settings.ccAccounts.add") }
						</button>
					</form>
				</section>
			</section>
		}

		<!-- Daemon de Engram -->
		<section class="settings-group">
			<h2 class="settings-group-title">{ T(d.Lang, "settings.daemon") }</h2>
			<div class="info-row">
				<span class="info-label muted">{ T(d.Lang, "settings.row.url") }</span>
				<span class="info-value mono">
					if d.DaemonURL != "" {
						{ d.DaemonURL }
					} else {
						{ "—" }
					}
				</span>
			</div>
			<div class="info-row">
				<span class="info-label muted">{ T(d.Lang, "settings.row.status") }</span>
				<span>
					if d.DaemonOk {
						<span class="badge badge-ok">{ T(d.Lang, "settings.badge.reachable") }</span>
					} else {
						<span class="badge badge-fail">{ T(d.Lang, "settings.badge.unreachable") }</span>
					}
				</span>
			</div>
			if !d.DaemonOk && d.DaemonError != "" {
				<p class="error-hint">{ d.DaemonError }</p>
			}
		</section>
	</div>
}

// moduleStateBadge returns the i18n key for the module state badge.
func moduleStateBadgeKey(s ModuleState) string {
	switch s {
	case ModuleEnabled:
		return "settings.modules.state.enabled"
	case ModuleDisabled:
		return "settings.modules.state.disabled"
	case ModuleDetected:
		return "settings.modules.state.detected"
	case ModuleErrored:
		return "settings.modules.state.errored"
	default:
		return "settings.modules.state.registered"
	}
}

// moduleRow renders one provider row in the Settings → Modules section.
// It shows: display name, state badge, path (if any), enable/disable toggle,
// and (for Tier-1 providers in non-Enabled state) a manual path entry form.
templ moduleRow(lang string, m ModuleInfo, pathError string) {
	<div class="module-row" id={ "module-" + m.ID }>
		<div class="module-row-header">
			<div class="module-row-identity">
				<span class="module-name">{ m.DisplayName }</span>
				<span class={ "badge", templ.KV("badge-ok", m.State == ModuleEnabled), templ.KV("badge-warn", m.State == ModuleDetected), templ.KV("badge-fail", m.State == ModuleErrored || m.State == ModuleDisabled) }>
					{ T(lang, moduleStateBadgeKey(m.State)) }
				</span>
			</div>
			<div class="module-row-toggle">
				if m.State == ModuleEnabled {
					<form method="post" action={ templ.SafeURL("/settings/modules/" + m.ID + "/toggle") }
						hx-post={ "/settings/modules/" + m.ID + "/toggle" }
						hx-target="#settings-modules"
						hx-swap="outerHTML">
						<input type="hidden" name="enabled" value="false"/>
						<button type="submit" class="btn btn-sm btn-secondary">
							{ T(lang, "settings.modules.disable") }
						</button>
					</form>
				} else if m.State == ModuleDisabled || m.State == ModuleDetected {
					<form method="post" action={ templ.SafeURL("/settings/modules/" + m.ID + "/toggle") }
						hx-post={ "/settings/modules/" + m.ID + "/toggle" }
						hx-target="#settings-modules"
						hx-swap="outerHTML">
						<input type="hidden" name="enabled" value="true"/>
						<button type="submit" class="btn btn-sm btn-primary">
							{ T(lang, "settings.modules.enable") }
						</button>
					</form>
				}
			</div>
		</div>
		if m.Path != "" {
			<div class="info-row">
				<span class="info-label muted">{ T(lang, "settings.row.path") }</span>
				<span class="info-value mono">{ m.Path }</span>
			</div>
		}
		if m.Err != "" {
			<p class="error-hint">{ m.Err }</p>
		}
		<!-- Tier-1 manual path entry: show when provider is not enabled -->
		if m.Tier == ModuleTier1 && m.State != ModuleEnabled {
			<form class="path-edit-form" method="post"
				action={ templ.SafeURL("/settings/modules/" + m.ID + "/path") }
				hx-post={ "/settings/modules/" + m.ID + "/path" }
				hx-target="#settings-modules"
				hx-swap="outerHTML">
				<input
					type="text"
					name="path"
					value={ m.Path }
					class="path-input mono"
					autocomplete="off"
					autocapitalize="off"
					spellcheck="false"
					aria-label={ T(lang, "settings.modules.pathLabel") }
					placeholder={ T(lang, "settings.modules.pathPlaceholder") }
				/>
				<button type="submit" class="btn btn-sm btn-primary">
					{ T(lang, "settings.modules.validateAndActivate") }
				</button>
			</form>
			if pathError != "" {
				<p class="error-hint">{ pathError }</p>
			}
		}
	</div>
}

// ccAccountRow renders one CC account row in the Settings → CC Accounts section.
// isLast is true when this is the only remaining account (disables the remove button).
templ ccAccountRow(lang string, acc CCAccountInfo, isLast bool) {
	<div class="module-row" id={ "cc-account-" + acc.ID }>
		<div class="module-row-header">
			<div class="module-row-identity">
				<span class="module-name">{ acc.Label }</span>
				if acc.Enabled {
					<span class="badge badge-ok">{ T(lang, "settings.ccAccounts.enabled") }</span>
				} else {
					<span class="badge badge-fail">{ T(lang, "settings.ccAccounts.disabled") }</span>
				}
			</div>
			<div class="module-row-toggle">
				if acc.Enabled {
					<form method="post" action={ templ.SafeURL("/settings/cc-accounts/" + acc.ID + "/toggle") }
						hx-post={ "/settings/cc-accounts/" + acc.ID + "/toggle" }
						hx-target="#settings-cc-accounts"
						hx-swap="outerHTML">
						<input type="hidden" name="enabled" value="false"/>
						<button type="submit" class="btn btn-sm btn-secondary">
							{ T(lang, "settings.modules.disable") }
						</button>
					</form>
				} else {
					<form method="post" action={ templ.SafeURL("/settings/cc-accounts/" + acc.ID + "/toggle") }
						hx-post={ "/settings/cc-accounts/" + acc.ID + "/toggle" }
						hx-target="#settings-cc-accounts"
						hx-swap="outerHTML">
						<input type="hidden" name="enabled" value="true"/>
						<button type="submit" class="btn btn-sm btn-primary">
							{ T(lang, "settings.modules.enable") }
						</button>
					</form>
				}
				if isLast {
					<button type="button" class="btn btn-sm btn-secondary" disabled title={ T(lang, "settings.ccAccounts.cannotRemoveLast") }>
						{ T(lang, "settings.ccAccounts.remove") }
					</button>
				} else {
					<form method="post" action={ templ.SafeURL("/settings/cc-accounts/" + acc.ID + "/remove") }
						hx-post={ "/settings/cc-accounts/" + acc.ID + "/remove" }
						hx-target="#settings-cc-accounts"
						hx-swap="outerHTML">
						<button type="submit" class="btn btn-sm btn-secondary">
							{ T(lang, "settings.ccAccounts.remove") }
						</button>
					</form>
				}
			</div>
		</div>
		if acc.Path != "" {
			<div class="info-row">
				<span class="info-label muted">{ T(lang, "settings.row.path") }</span>
				<span class="info-value mono">{ acc.Path }</span>
			</div>
		}
	</div>
}

// navVisibilityControls renders Show/Hide toggle buttons for a sidebar section
// (section is "engram" or "claude"). The active state is highlighted.
templ navVisibilityControls(lang, section string, shown bool) {
	<div class="preference-controls">
		<form method="post" action="/settings/nav-visibility">
			<input type="hidden" name="section" value={ section }/>
			<button
				type="submit"
				name="value"
				value="show"
				class={ "btn btn-sm", templ.KV("btn-primary", shown), templ.KV("btn-secondary", !shown) }
			>
				{ T(lang, "settings.navShow") }
			</button>
		</form>
		<form method="post" action="/settings/nav-visibility">
			<input type="hidden" name="section" value={ section }/>
			<button
				type="submit"
				name="value"
				value="hide"
				class={ "btn btn-sm", templ.KV("btn-primary", !shown), templ.KV("btn-secondary", shown) }
			>
				{ T(lang, "settings.navHide") }
			</button>
		</form>
	</div>
}
